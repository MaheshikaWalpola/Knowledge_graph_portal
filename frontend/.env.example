# Local development: copy to frontend/.env.
# Production build:  copy to frontend/.env.production (values are compiled in by `npm run build`).
# git ignores both, so a pull never overwrites them. See READMe.md, Production Deployment.

# Backend API base URL (no trailing slash). The app refuses to start without it.
#   local:      http://localhost:8000
#   production: https://vsr.informatik.tu-chemnitz.de/knowledgegraphportal/api
VITE_API_URL=http://localhost:8000

# Path prefix the app is served under: "/" locally, "/knowledgegraphportal/" on the server
VITE_BASE_PATH=/

# Only when the Vite dev server itself runs behind the reverse proxy (not needed for a static build):
# VITE_PUBLIC_ORIGIN=https://vsr.informatik.tu-chemnitz.de

VITE_CMP_NS=https://tucid/cmpo/
