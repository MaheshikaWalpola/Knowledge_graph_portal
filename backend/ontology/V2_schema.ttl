_:node51 a owl:Restriction .

_:node50 rdf:first cmpo:hasUsageId;
  rdf:rest rdf:nil .

cmpo:hasLotType rdfs:comment "Classifies a wafer lot by its purpose in the fab production flow."@en;
  rdfs:label "has lot type"@en .

cmpo:hasMaterialRemovalRate rdfs:comment "Rate of material removal during a CMP process, measured in nanometers per minute (nm/min)."@en .

cmpo:hasMaxValue rdfs:comment "Upper bound of the process window."@en;
  rdfs:label "Maximum Value"@en .

cmpo:ProcessWindow rdfs:comment "The range of acceptable values for a process parameter within which the CMP process reliably yields conforming wafers. Derived from design-of-experiment (DOE) studies."@en;
  rdfs:label "Process Window"@en .

cmpo:hasMeasuredValue rdfs:comment "The actual pressure value measured for a zone."@en;
  rdfs:label "has measured value" .

cmpo:hasMinValue rdfs:comment "Lower bound of the process window."@en;
  rdfs:label "Minimum Value"@en .

cmpo:hasMotionProfile rdfs:comment "Defines the motion pattern applied by the carrier."@en .

cmpo:hasNextStep rdfs:comment "Links a step to the immediately following step in the polishing sequence. Enables linked-list traversal of the process workflow."@en;
  rdfs:label "has next step"@en .

cmpo:hasNotch rdfs:comment "Identifies the type of alignment feature present on the wafer edge."@en;
  rdfs:label "has notch"@en .

cmpo:hasNumber rdfs:comment "Defines the chamber number in a specific tool where the wafer is processed. NOT pressure chambers in the Carrier."@en .

cmpo:hasOrientation rdfs:comment "Specifies the crystallographic orientation of the wafer."@en .

cmpo:CrystallographicOrientation rdfs:comment "Orientation of wafer crystal lattice relative to wafer flat; affects polishing behavior."@en;
  rdfs:label "Crystallographic Orientation"@en .

cmpo:hasPolishingMode rdfs:comment "Specifies the functional polishing mode of a CMP step within the process sequence."@en;
  rdfs:label "has polishing mode"@en .

cmpo:ProcessOwner rdfs:comment "Process owner is the person who is responsible for a specific process or tool."@en;
  rdfs:label "Prozessverantwortlicher"@de, "Process Owner"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "Tool Expert"@en, "Expert"@en, "Operator"@en .

cmpo:hasProcessWindow rdfs:comment "Specifies the valid operating range (process window) for a recipe or monitoring parameter."@en;
  rdfs:label "has process window"@en .

cmpo:hasProjectName rdfs:comment "Every Wafer and every Lot belongs to a specific Project. For Dummy wafer the Project is called Dummy. For all other projects it is a name or a project number. Example: Project: XENA."@en .

cmpo:ProjectOwner rdfs:comment "Project owner is the Person who is responsible for the wafer lot. The project owner acts like the customer for the process (defines target values)."@en;
  rdfs:label "Projektverantwortlicher"@de, "Project Owner"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "Lot Owner"@en, "Verantwortlich"@de .

cmpo:hasQualificationStatus rdfs:comment "Status of tool qualification (e.g., 'Qualified', 'In-Progress', 'Not-Qualified')."@en;
  rdfs:label "Qualification Status"@en .

cmpo:hasRotationSpeed rdfs:comment "Velocity of the Platen measured in RPM (revolutions per minute). In PHM data it is Stage Rotation."@en;
  rdfs:label "Rotation Speed"@en, "Platen Rotation Speed"@en .

cmpo:hasSPCLimit rdfs:comment "Associates a process or monitoring parameter with its SPC control and specification limits."@en;
  rdfs:label "has SPC limit"@en .

cmpo:SPCLimit rdfs:comment "Statistical Process Control (SPC) limits for monitoring process stability. Distinguishes between control limits (3-sigma, trigger for investigation) and specification limits (engineering tolerance)."@en;
  rdfs:label "SPC Limit"@en .

cmpo:hasSelectivity rdfs:comment "Associates a polishing step with its material selectivity characterisation."@en;
  rdfs:label "has selectivity"@en .

cmpo:MaterialSelectivity rdfs:comment "Ratio of the removal rate of a primary material to that of a reference material under the same CMP conditions. Key for stop-on-layer and barrier CMP steps."@en;
  rdfs:label "Material Selectivity"@en .

cmpo:hasSetPoint rdfs:comment "The target pressure value (set-point) for a zone."@en;
  rdfs:label "has set-point", "Set Point"@en .

cmpo:hasSlurryFlowRate rdfs:comment "Links a SlurryPipe to its SlurryFlowRate parameter."@en .

cmpo:hasStepIndex rdfs:comment "1-based integer ordering of this step within its parent Service or process sequence. Enables correct reconstruction of multi-step workflows."@en;
  rdfs:label "Step Index"@en .

cmpo:hasSubstrate rdfs:comment "Substrate is the Material the pure wafer is made from. In most cases this is Silicon."@en .

cmpo:hasThickness rdfs:comment "Applies to all values for thickness such as wafer thickness or layer thickness."@en .

cmpo:hasToolType rdfs:comment "Classifies a CMP tool by its kinematic configuration (rotary, linear or orbital)."@en;
  rdfs:label "has tool type"@en .

cmpo:UsageTracking rdfs:comment "A generic class for tracking the usage metrics (e.g., runtime, count, wear) of consumables or tools."@en;
  rdfs:label "Usage Tracking"@en;
  owl:hasKey _:node50 .

cmpo:hasUsageType rdfs:comment "Describes the type of usage (e.g., 'Polishing', 'Conditioning')."@en;
  rdfs:label "Usage Type"@en .

cmpo:hasWIWNU rdfs:comment "Within-Wafer Non-Uniformity value (%) for a specific wafer after CMP. Calculated as: (max - min) / (2 × mean) × 100, or as 1-sigma / mean × 100."@en;
  rdfs:label "WIWNU"@en .

cmpo:hasWTWU rdfs:comment "Wafer-to-Wafer Uniformity value (%) for a lot after CMP. High WTWU indicates process drift, slurry ageing or pad wear."@en;
  rdfs:label "WTWU"@en .

cmpo:hasWaferID rdfs:comment "hasWaferID is a property that links a Wafer to its WaferID."@en .

cmpo:ionicStrength rdfs:comment "Ionic strength of the slurry solution, measured in mol/L or mM."@en;
  rdfs:label "Ionic Strength"@en .

cmpo:lowerControlLimit rdfs:comment "Lower Control Limit (LCL): -3σ boundary. Values below LCL trigger a process investigation."@en;
  rdfs:label "Lower Control Limit"@en .

cmpo:lowerSpecLimit rdfs:comment "Lower Specification Limit (LSL): engineering tolerance lower bound. Wafers below LSL are non-conforming."@en;
  rdfs:label "Lower Specification Limit"@en, "Lower Spec Limit"@en .

cmpo:numberOfZones rdfs:comment "An annotation to specify how many pressure zones a carrier type has."@en;
  rdfs:label "Number of Pressure Zones" .

cmpo:orientationPlane rdfs:comment "Miller indices representing the wafer surface orientation (e.g., '100', '111')."@en;
  rdfs:label "Orientation Plane"@en .

cmpo:padCompressibility rdfs:comment "Percentage compressibility of the pad under standard load conditions (%). Affects contact area distribution and pressure uniformity across the wafer."@en;
  rdfs:label "Pad Compressibility"@en .

cmpo:padHardness rdfs:comment "Shore D hardness of the polishing pad. Harder pads (higher value, e.g., ~60) provide better global planarisation; softer pads (lower value, e.g., ~40) give lower scratch defectivity."@en;
  rdfs:label "Pad Hardness"@en .

cmpo:padLifetimeMinutes rdfs:comment "Total accumulated polishing time (in minutes) allowed for this pad instance before replacement."@en;
  rdfs:label "Pad Lifetime Minutes"@en .

cmpo:padLifetimeWaferCount rdfs:comment "Maximum number of wafers to be processed on this pad before replacement. Pad wear leads to reduced MRR and degraded uniformity."@en;
  rdfs:label "Pad Lifetime Wafer Count"@en .

cmpo:particleConcentration rdfs:comment "Number of particles per unit volume (particles/mL)."@en;
  rdfs:label "Particle Concentration"@en .

cmpo:particleSize rdfs:comment "Average size of abrasive particles in the slurry, measured in nanometers (nm)."@en;
  rdfs:label "Abrasive Particle Size"@en, "Particle Size"@en .

cmpo:polishingDuration rdfs:comment "Total time in seconds for the polishing step."@en;
  rdfs:label "Polishing Duration"@en .

cmpo:prestonCoefficient rdfs:comment "Preston coefficient (k_p) for a given step; depends on pad, slurry and material combination. Unit: 1/(Pa). Higher k_p means more aggressive removal per unit of pressure×velocity."@en;
  rdfs:label "Preston Coefficient"@en .

cmpo:primaryMaterial rdfs:comment "The material being preferentially removed (numerator of the selectivity ratio)."@en;
  rdfs:label "primary material"@en .

cmpo:relativeVelocityFormula rdfs:comment "Formula for calculating relative velocity from platen and carrier rotation speeds."@en;
  rdfs:label "Relative Velocity Formula"@en .

cmpo:runsOnPlaten rdfs:comment "Specifies which physical platen this step executes on. Critical for multi-platen CMP tools where different steps run on different platens simultaneously."@en;
  rdfs:label "runs on platen"@en .

cmpo:seasoningDate rdfs:comment "Date when the tool underwent initial seasoning/break-in process."@en;
  rdfs:label "Seasoning Date"@en .

cmpo:secondaryMaterial rdfs:comment "The reference or stop-layer material (denominator of the selectivity ratio)."@en;
  rdfs:label "secondary material"@en .

cmpo:selectivityRatio rdfs:comment "Numerical ratio of removal rate of the primary material to the reference material (e.g., Cu:SiO2 = 10.0 means Cu is removed 10× faster than SiO2)."@en;
  rdfs:label "Selectivity Ratio"@en .

cmpo:slurryDilutionRatio rdfs:comment "Ratio of slurry concentrate volume to total volume after dilution with DI water (e.g., 0.5 = 1:1 dilution). Affects abrasive concentration and MRR."@en;
  rdfs:label "Slurry Dilution Ratio"@en .

cmpo:slurryFlowRateValue rdfs:comment "Slurry flow rate value for a specific Slurry pipe. In the PHM data set this is Slurry_Flow_Line_A."@en;
  rdfs:label "Slurry Flow"@en .

cmpo:slurryPH rdfs:comment "pH value of the slurry (0-14 scale)."@en;
  rdfs:label "Slurry pH"@en .

cmpo:slurryViscosity rdfs:comment "Dynamic viscosity of the slurry, typically measured in centiPoise (cP) or mPa·s."@en;
  rdfs:label "Slurry Viscosity"@en .

cmpo:solidContent rdfs:comment "Percentage of solid particles (abrasives) in the slurry by weight or volume (%)."@en;
  rdfs:label "Solid Content"@en .

cmpo:targetRemovalAmount rdfs:comment "Nominal thickness of material to be removed during this CMP step, in nanometers (nm). Defined in the process card."@en;
  rdfs:label "Target Removal Amount"@en .

cmpo:targetUniformity rdfs:comment "Target within-wafer uniformity (WIWU) or die-to-die uniformity specification as a percentage or absolute value."@en;
  rdfs:label "Target Uniformity"@en .

cmpo:targetValue rdfs:comment "Nominal (target) value for the monitored parameter. Centre of the SPC chart."@en;
  rdfs:label "Target Value"@en .

cmpo:targetsSide rdfs:comment "Defines which wafer side has to be processed."@en .

cmpo:temperatureInC rdfs:comment "The pad temperature is measured in degrees Celsius."@en;
  rdfs:label "Pad Temperature"@en, "Temperature"@en .

cmpo:tracksComponent rdfs:comment "Connects tracking data with a physical tool component."@en;
  rdfs:label "tracks component"@en .

cmpo:ToolQualification rdfs:comment "Process of preparing and qualifying a CMP tool for production use."@en;
  rdfs:label "Tool Qualification"@en .

cmpo:uniformityTolerance rdfs:comment "Acceptable tolerance for thickness uniformity across the wafer (±%)."@en;
  rdfs:label "Uniformity Tolerance"@en .

cmpo:upperControlLimit rdfs:comment "Upper Control Limit (UCL): +3σ boundary. Exceeding UCL triggers a process investigation without necessarily scrapping the wafer."@en;
  rdfs:label "Upper Control Limit"@en .

cmpo:upperSpecLimit rdfs:comment "Upper Specification Limit (USL): engineering tolerance upper bound. Wafers exceeding USL are non-conforming."@en;
  rdfs:label "Upper Specification Limit"@en, "Upper Spec Limit"@en .

cmpo:usesEPDMethod rdfs:comment "Specifies which EPD method is employed for a polishing step."@en .

cmpo:usesPrestonModel rdfs:comment "Links a polishing step to its Preston equation model instance for MRR prediction."@en;
  rdfs:label "uses Preston model"@en .

cmpo:PrestonEquation rdfs:comment "Fundamental CMP model: MRR = k_p × P × V, where k_p is the Preston coefficient, P is contact pressure and V is relative velocity. Captures the combined mechanical and chemical removal mechanism."@en;
  rdfs:label "Preston Equation"@en .

cmpo:usesRTRControl rdfs:comment "Indicates that this polishing step is governed by a run-to-run APC strategy."@en;
  rdfs:label "uses run-to-run control"@en .

cmpo:zetaPotential rdfs:comment "Electrokinetic potential (mV) of abrasive particles in the slurry. Values more negative than -30 mV indicate stable colloidal dispersion; values near zero indicate risk of agglomeration and scratch defects."@en;
  rdfs:label "Zeta Potential"@en .

cmpo:hasPressureZone rdfs:comment "A carrier may have multiple pressure zones. The number and configuration depend on the tool."@en;
  rdfs:label "has Pressure Zone"@en .

cmpo:RelativeVelocityParameter rdfs:comment "Class version of the legacy datatype property cmpo:RelativeVelocity."@en;
  rdfs:label "Relative Velocity"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "RelativeVelocity"@en .

cmpo:EPDMethod rdfs:label "EPD Method"@en .

cmpo:AverageRemovalRate rdfs:label "Average Removal Rate"@en .

cmpo:WaferMaterialRemovalRate rdfs:label "Wafer Material Removal Rate"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "MRR"@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Material Removal Rate"@en .

cmpo:BackingFilmUsage rdfs:label "Usage Of Backing Film"@en .

cmpo:PadLifetime rdfs:label "Pad Lifetime"@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Pad Lifetime"@en .

cmpo:Agent rdfs:label "Agent"@en .

cmpo:CenterAirBagPressure rdfs:label "Center Air Bag Pressure"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "CENTER_AIR_BAG_PRESSURE"@en .

