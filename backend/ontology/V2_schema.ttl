  <http://www.w3.org/2004/02/skos/core#prefLabel> "Pressure"@en .

cmpo:Step rdfs:label "Step"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "Task"@en .

cmpo:ControlWafer rdfs:label "Control Wafer"@en, "Kontrollwafer"@de;
  <http://www.w3.org/2004/02/skos/core#altLabel> "K-Scheibe"@de .

cmpo:Wafer rdfs:label "Wafer"@en .

cmpo:Dishing rdfs:label "Dishing"@en .

cmpo:DresserTableUsage rdfs:label "Usage Of Dresser Table"@en .

cmpo:DresserUsage rdfs:label "Usage Of Dresser"@en .

cmpo:Conditioning rdfs:label "Conditioning"@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Conditioning"@en .

cmpo:DressingWaterStatus rdfs:label "Dressing Water Status"@en .

cmpo:DummyWafer rdfs:label "Dummy Wafer"@en .

cmpo:EdgeAirBagPressure rdfs:label "Edge Air Bag Pressure"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "EDGE_AIR_BAG_PRESSURE"@en .

cmpo:Erosion rdfs:label "Erosion"@en .

cmpo:HeadRotation rdfs:label "Head Rotation"@en .

cmpo:HeadSpeed rdfs:label "Head Speed"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "Head Rotation"@en, "Carrier RPM"@en .

cmpo:MainOuterAirBagPressure rdfs:label "Main Outer Air Bag Pressure"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "MAIN_OUTER_AIR_BAG_PRESSURE"@en .

cmpo:MembraneUsage rdfs:label "Usage Of Membrane"@en .

cmpo:Parameter rdfs:label "Parameter"@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Parameter"@en .

cmpo:MotorCurrentEPD rdfs:label "Motor Current EPD"@en .

cmpo:OpticalEPD rdfs:label "Optical EPD"@en .

