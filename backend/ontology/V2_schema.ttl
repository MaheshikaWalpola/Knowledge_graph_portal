cmpo:SlurryFlowLineC rdfs:label "Slurry Flow Line C"@en .

cmpo:SlurryPipe rdfs:label "Slurry Pipe"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "Slurry Delivery Pipe"@en, "Slurry Line"@en .

