cmpo:PressurizedSheetUsage rdfs:label "Usage Of Pressurized Sheet"@en .

cmpo:RetainingRingPressure rdfs:label "Retaining Ring Pressure"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "RETAINER_RING_PRESSURE"@en .

cmpo:RippleAirBagPressure rdfs:label "Ripple Air Bag Pressure"@en;
  <http://www.w3.org/2004/02/skos/core#altLabel> "RIPPLE_AIR_BAG_PRESSURE"@en .

cmpo:Scratch rdfs:label "Scratch"@en .

cmpo:SlurryFlowLineA rdfs:label "Slurry Flow Line A"@en .

cmpo:SlurryFlow rdfs:label "Slurry Flow"@en;
  <http://www.w3.org/2004/02/skos/core#prefLabel> "Slurry Flow"@en .

