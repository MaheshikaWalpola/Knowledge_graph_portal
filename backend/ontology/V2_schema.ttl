@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cmpo: <https://tucid/cpmo/> .
@prefix rdf4j: <http://rdf4j.org/schema/rdf4j#> .
@prefix sesame: <http://www.openrdf.org/schema/sesame#> .
@prefix fn: <http://www.w3.org/2005/xpath-functions#> .

cmpo:EPDMethod a owl:Class;
  rdfs:subClassOf cmpo:EndPointDetection;
  rdfs:comment "Specific technique or sensor used for end-point detection."@en .

cmpo:AverageRemovalRate a owl:Class;
  rdfs:subClassOf cmpo:WaferMaterialRemovalRate .

cmpo:WaferMaterialRemovalRate a owl:Class;
  rdfs:subClassOf cmpo:Parameter .

cmpo:BackingFilmUsage a owl:Class;
  rdfs:subClassOf cmpo:PadLifetime .

cmpo:PadLifetime a owl:Class;
  rdfs:subClassOf cmpo:Parameter;
  rdfs:comment "Usage and lifetime tracking parameters for pads, dresser tables, and backing films."@en .

cmpo:Agent a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000030> .

cmpo:CenterAirBagPressure a owl:Class;
  rdfs:subClassOf cmpo:Pressure .

cmpo:Pressure a owl:Class;
  rdfs:subClassOf cmpo:Parameter;
  rdfs:comment "Pressure-related CMP parameters, normally measured in psi or bar."@en .

cmpo:Tool a owl:Class;
  rdfs:subClassOf cmpo:Equipment;
  rdfs:comment "Tools are all kinds of tools for processing and measuring wafers. Specific tools are instances."@en .

cmpo:Recipe a owl:Class;
  rdfs:comment "A recipe is a collection of components with specific (input) parameters like pressure values or conditioning pad sweeps per minute."@en .

cmpo:Step a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015>;
  rdfs:comment "One action or step in the whole workflow of a process. Example: measuring step on FTR or polishing process on CMP tool."@en .

cmpo:ControlWafer a owl:Class;
  rdfs:subClassOf cmpo:Wafer;
  rdfs:comment "ControlWafer are unstructured Wafer in a specific WaferLot. ControlWafer are used to measure wafer properties such as uniformity and roughness before the polishing process. They are used to calculate the MRR."@en .

cmpo:Wafer a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000030>;
  rdfs:comment "Wafer is a silicon substrate that is used as a substrate for semiconductor devices."@en .

cmpo:Dishing a owl:Class;
  rdfs:subClassOf cmpo:CMPDefect;
  rdfs:comment "Localized depression or sinking of the polished surface below the original level."@en .

cmpo:DresserTableUsage a owl:Class;
  rdfs:subClassOf cmpo:PadLifetime .

cmpo:DresserUsage a owl:Class;
  rdfs:subClassOf cmpo:Conditioning .

cmpo:Conditioning a owl:Class;
  rdfs:subClassOf cmpo:Parameter;
  rdfs:comment "Pad-conditioning parameters such as mode, force, rotation speed, and water status."@en .

cmpo:DressingWaterStatus a owl:Class;
  rdfs:subClassOf cmpo:Conditioning .

cmpo:DummyWafer a owl:Class;
  rdfs:subClassOf cmpo:Wafer;
  rdfs:comment "DummyWafer are pure Silicon Wafer. DummyWafer are used to break-in tools before actual use or to check tool functionality after equipment change."@en .

cmpo:EdgeAirBagPressure a owl:Class;
  rdfs:subClassOf cmpo:Pressure .

cmpo:Erosion a owl:Class;
  rdfs:subClassOf cmpo:CMPDefect;
  rdfs:comment "Non-uniform removal of material, creating recessed regions."@en .

cmpo:HeadRotation a owl:Class;
  rdfs:subClassOf cmpo:HeadSpeed .

cmpo:HeadSpeed a owl:Class;
  rdfs:subClassOf cmpo:Velocity .

cmpo:MainOuterAirBagPressure a owl:Class;
  rdfs:subClassOf cmpo:Pressure .

cmpo:MembraneUsage a owl:Class;
  rdfs:subClassOf cmpo:Parameter .

cmpo:Parameter a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019>;
  rdfs:comment "A measurable CMP process parameter. Base class for search-groupable process values."@en .

cmpo:Measurement a owl:Class .

cmpo:MotorCurrentEPD a owl:Class;
  rdfs:subClassOf cmpo:EPDMethod;
  rdfs:comment "Detection based on motor current signature analysis."@en .

cmpo:OpticalEPD a owl:Class;
  rdfs:subClassOf cmpo:EPDMethod;
  rdfs:comment "Optical spectrometry-based end-point detection."@en .

cmpo:PolishingTableUsage a owl:Class;
  rdfs:subClassOf cmpo:PadLifetime .

cmpo:PressurizedChamberPressure a owl:Class;
  rdfs:subClassOf cmpo:Pressure .

cmpo:PressurizedSheetUsage a owl:Class;
  rdfs:subClassOf cmpo:Parameter .

cmpo:RetainingRingPressure a owl:Class;
  rdfs:subClassOf cmpo:Pressure .

cmpo:RippleAirBagPressure a owl:Class;
  rdfs:subClassOf cmpo:Pressure .

cmpo:Scratch a owl:Class;
  rdfs:subClassOf cmpo:CMPDefect;
  rdfs:comment "Fine linear scratches caused by abrasive particles or pad irregularities."@en .

cmpo:SlurryFlowLineA a owl:Class;
  rdfs:subClassOf cmpo:SlurryFlow .

cmpo:SlurryFlow a owl:Class;
  rdfs:subClassOf cmpo:Parameter;
  rdfs:comment "Slurry delivery flow-rate parameters."@en .

cmpo:SlurryFlowLineB a owl:Class;
  rdfs:subClassOf cmpo:SlurryFlow .

cmpo:SlurryFlowLineC a owl:Class;
  rdfs:subClassOf cmpo:SlurryFlow .

cmpo:SlurryPipe a owl:Class;
  rdfs:subClassOf cmpo:ToolComponent;
  rdfs:comment "Slurry Pipes are used for Slurry and DI Water for rinsing and cleaning depending on the step."@en .

cmpo:ToolComponent a owl:Class .

cmpo:StageRotation a owl:Class;
  rdfs:subClassOf cmpo:PlatenSpeed .

cmpo:PlatenSpeed a owl:Class;
  rdfs:subClassOf cmpo:Velocity .

cmpo:WaferRotation a owl:Class;
  rdfs:subClassOf cmpo:Velocity .

cmpo:Velocity a owl:Class;
  rdfs:subClassOf cmpo:Parameter;
  rdfs:comment "Rotational or relative velocity parameters used in CMP."@en .

cmpo:Lot a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000030> .

cmpo:Project a owl:Class .

cmpo:Slurry a owl:Class;
  rdfs:subClassOf cmpo:Consumable, _:node51 .

cmpo:Conditioner a owl:Class;
  rdfs:subClassOf cmpo:ToolComponent .

cmpo:conditions a owl:ObjectProperty;
  rdfs:domain cmpo:Conditioner;
  rdfs:range cmpo:PolishingPad;
  rdfs:comment "Conditioning happens during the polishing step and is measured and configured in sweeps per minute."@en .

cmpo:PolishingPad a owl:Class;
  rdfs:subClassOf cmpo:Consumable .

cmpo:ConditionerPad a owl:Class;
  rdfs:subClassOf cmpo:Consumable .

cmpo:Chamber a owl:Class;
  rdfs:subClassOf cmpo:ToolComponent .

cmpo:hasDiameter a owl:DatatypeProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range xsd:float;
  rdfs:comment "Wafer diameter is given either in inch or mm. Most common: 150 mm (6 inch), 200 mm (8 inch), 300 mm (12 inch)."@en .

cmpo:hasLayer a owl:ObjectProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range cmpo:Layer;
  rdfs:comment "Layer is a specific material and layout the wafer has. Structured wafer could have multiple layers. Dummy wafer do not have layers."@en .

cmpo:Layer a owl:Class;
  rdfs:comment "Layer is a specific material and layout the wafer has. Structured wafer could have multiple layers. Dummy wafer don't have layers."@en .

cmpo:StructuredWafer a owl:Class;
  rdfs:subClassOf cmpo:Wafer;
  rdfs:comment "StructuredWafer are Wafer in a WaferLot with Layout for actual production. StructuredWafer are the main process wafer, which might not be measured by using non-destructive methods (e.g. optical methods)."@en .

cmpo:hasLowerLimit a owl:DatatypeProperty;
  rdfs:domain cmpo:Parameter;
  rdfs:range xsd:float .

cmpo:hasMaterial a owl:ObjectProperty;
  rdfs:domain cmpo:Layer;
  rdfs:range cmpo:Material .

cmpo:hasMeasurement a owl:ObjectProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range cmpo:Measurement .

cmpo:hasNumericValue a owl:DatatypeProperty;
  rdfs:domain cmpo:Parameter;
  rdfs:range xsd:float;
  rdfs:comment "The main numeric value property used by ontology_v2-style parameter instances."@en .

cmpo:hasParameterName a owl:DatatypeProperty;
  rdfs:domain cmpo:Parameter;
  rdfs:range xsd:string .

cmpo:hasPolishingPad a owl:ObjectProperty;
  rdfs:domain cmpo:Platen;
  rdfs:range cmpo:PolishingPad;
  owl:inverseOf cmpo:isMountedOn .

cmpo:RetainingRing a owl:Class;
  rdfs:subClassOf cmpo:Consumable .

cmpo:hasRole a owl:ObjectProperty;
  rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000030>;
  rdfs:range <http://purl.obolibrary.org/obo/BFO_0000023> .

cmpo:hasStatus a owl:DatatypeProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range xsd:string;
  rdfs:comment "WaferStatus describes defects and pre-process status of a specific Wafer."@en .

cmpo:hasTargetValue a owl:DatatypeProperty;
  rdfs:domain cmpo:Parameter;
  rdfs:range xsd:float .

cmpo:hasTimestamp a owl:DatatypeProperty;
  rdfs:domain cmpo:WaferState;
  rdfs:range xsd:dateTime .

cmpo:hasToolComponent a owl:ObjectProperty;
  rdfs:domain cmpo:Tool;
  rdfs:range cmpo:ToolComponent .

cmpo:hasUnit a owl:DatatypeProperty;
  rdfs:domain cmpo:Parameter;
  rdfs:range xsd:string;
  rdfs:comment "Measurement unit stored as a string, following the ontology_v2 instance pattern, e.g. psi, rpm, ml/min, nm/min, count."@en .

cmpo:hasUpperLimit a owl:DatatypeProperty;
  rdfs:domain cmpo:Parameter;
  rdfs:range xsd:float .

cmpo:Platen a owl:Class;
  rdfs:subClassOf cmpo:ToolComponent;
  rdfs:comment "The large rotating disk where the polishing pad is mounted."@en .

cmpo:Carrier a owl:Class;
  rdfs:subClassOf cmpo:ToolComponent, _:node49;
  rdfs:comment "The carrier holds the wafer during polishing. At least one pressure zone is required for functional operation."@en .

cmpo:isMountedOn a owl:ObjectProperty;
  rdfs:domain cmpo:PolishingPad;
  rdfs:range cmpo:Platen;
  rdfs:comment "Relates a consumable polishing pad to the specific platen it is currently attached to."@en .

cmpo:isSpecifiedBy a owl:ObjectProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range cmpo:ProcessCard .

cmpo:ProcessCard a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030>;
  rdfs:comment "A document connected to a WaferLot, which contains information about all wafers in the lot including defects and notes as well as target values and planned processes (Services)."@en .

cmpo:Equipment a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000030> .

cmpo:lotSize a owl:DatatypeProperty;
  rdfs:domain cmpo:Lot;
  rdfs:range xsd:integer;
  rdfs:comment "Total number of wafer slots in the lot (including control, structured and dummy wafers). Typical: 25 for 200 mm, 25 for 300 mm lots."@en .

cmpo:padType a owl:DatatypeProperty;
  rdfs:domain cmpo:PolishingPad;
  rdfs:range xsd:string;
  rdfs:comment "Commercial name or identifier of the polishing pad (e.g., 'IC1000', 'IC1010', 'NexPlanar E6000', 'Politex', 'SPM3100'). Determines mechanical and tribological characteristics."@en .

cmpo:schema a owl:Ontology;
  rdfs:comment "CMP Schema-Level Ontology aligned with BFO (TBox + schema connections)"@en .

cmpo:slurryName a owl:DatatypeProperty;
  rdfs:domain cmpo:Slurry;
  rdfs:range xsd:string;
  rdfs:comment "Name of the Slurry, e.g. KLEBOSOL."@en .

cmpo:Consumable a owl:Class;
  rdfs:subClassOf cmpo:ToolComponent;
  rdfs:comment "Consumables are ToolComponents that change over time and have a lifetime or specific service life."@en .

cmpo:usesRecipe a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:Recipe .

cmpo:usesTool a owl:ObjectProperty;
  rdfs:domain cmpo:Measurement;
  rdfs:range cmpo:Tool .

cmpo:AFMTool a owl:Class;
  rdfs:subClassOf cmpo:MetrologyTool;
  rdfs:comment "Atomic Force Microscopy (AFM) tool. Measures surface roughness (Ra, Rq, Rz) at nanometre resolution. Used to characterise post-CMP surface quality and scratch depth."@en .

cmpo:MetrologyTool a owl:Class;
  rdfs:subClassOf cmpo:Tool;
  rdfs:comment "A tool used exclusively for measurement and characterisation of wafer properties; does not perform material removal. Examples: FTR, AFM, ellipsometer, profilometer."@en .

cmpo:AluminaAbrasive a owl:Class;
  rdfs:subClassOf cmpo:AbrasiveType;
  rdfs:comment "Aluminium oxide (Al2O3) abrasive particles. Used in tungsten (W) and metal CMP due to higher hardness (Mohs ~9) and aggressive removal."@en .

cmpo:AbrasiveType a owl:Class;
  rdfs:comment "Material class of the abrasive particles suspended in the CMP slurry. Determines hardness, reactivity and selectivity characteristics."@en .

cmpo:Angstrom a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/ANGSTROM> .

cmpo:Unit a owl:Class;
  rdfs:subClassOf <http://qudt.org/schema/qudt/Unit>;
  rdfs:comment "Domain-specific unit class aligned with QUDT."@en .

cmpo:BackSide a owl:Class;
  rdfs:subClassOf cmpo:WaferSide .

cmpo:WaferSide a owl:Class .

cmpo:Buffing a owl:Class;
  rdfs:subClassOf cmpo:PolishingMode;
  rdfs:comment "Light final polishing step to improve surface roughness, reduce micro-scratches and remove slurry residue. Often on a soft Politex-type pad."@en .

cmpo:PolishingMode a owl:Class;
  rdfs:comment "Functional phase of a CMP polishing step within the overall planarisation sequence. Determines target removal rate, pad type and slurry formulation."@en .

cmpo:BulkRemoval a owl:Class;
  rdfs:subClassOf cmpo:PolishingMode;
  rdfs:comment "First polishing phase; rapidly removes the bulk of excess material at a high removal rate. Pad: stiff (IC1000); slurry: abrasive-rich."@en .

cmpo:CenterAirBagZone a owl:Class;
  rdfs:subClassOf cmpo:Pressure, cmpo:PressureZone .

cmpo:PressureZone a owl:Class;
  rdfs:comment "A region in a carrier that can be independently pressurized. The number and configuration vary by tool."@en .

cmpo:CeriaAbrasive a owl:Class;
  rdfs:subClassOf cmpo:AbrasiveType;
  rdfs:comment "Cerium oxide (CeO2) abrasive particles. Used in STI and oxide CMP for high SiO2/Si3N4 selectivity via chemical tooth mechanism. Enables better planarity control."@en .

cmpo:CleaningAgent a owl:Class;
  rdfs:subClassOf cmpo:Consumable;
  rdfs:comment "Chemical used in post-CMP cleaning process."@en .

cmpo:Clearing a owl:Class;
  rdfs:subClassOf cmpo:PolishingMode;
  rdfs:comment "Polishing phase designed to remove residual barrier (e.g., Ta, TaN) or seed layer from field regions after bulk metal removal."@en .

cmpo:Complexant a owl:Class;
  rdfs:subClassOf cmpo:ChemicalAdditive;
  rdfs:comment "Chemical that forms soluble metal complexes to facilitate dissolution and removal of oxidised metal ions from the surface (e.g., citric acid, glycine, NH4OH in Cu CMP)."@en .

cmpo:ChemicalAdditive a owl:Class;
  rdfs:comment "Chemical compound added to the CMP slurry to modify removal rate, selectivity, surface protection or colloidal stability."@en .

cmpo:ConcentricGroove a owl:Class;
  rdfs:subClassOf cmpo:GroovePattern;
  rdfs:comment "Concentric circular grooves on the pad surface. Common in IC1000; balances slurry retention and transport."@en .

cmpo:GroovePattern a owl:Class;
  rdfs:comment "Geometric groove configuration on the CMP polishing pad surface. Governs slurry transport across the pad, fresh abrasive delivery and contact mechanics."@en .

cmpo:ContactPressure a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Pressure, cmpo:Step;
  rdfs:range xsd:float;
  rdfs:comment "Pressure exerted at the wafer-pad interface, calculated from downforce and contact area, measured in PSI or Bar."@en .

cmpo:Corrosion a owl:Class;
  rdfs:subClassOf cmpo:CMPDefect;
  rdfs:comment "Chemical degradation of the wafer surface during polishing."@en .

cmpo:CMPDefect a owl:Class;
  rdfs:subClassOf cmpo:DefectType;
  rdfs:comment "Defects originating from the CMP polishing process."@en .

cmpo:DegreeCelsius a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/DEG_C> .

cmpo:DegreeFahrenheit a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/DEG_F> .

cmpo:DiWater a owl:Class;
  rdfs:subClassOf cmpo:Consumable, _:node47;
  rdfs:comment "DI Water is deionized water used for rinsing and cleaning."@en .

cmpo:isDeliveredBy a owl:ObjectProperty;
  rdfs:comment "Connects a specific SlurryPipe with a Slurry or DI Water via an instance."@en .

cmpo:DisturbanceParameter a owl:Class;
  rdfs:subClassOf cmpo:Parameter;
  rdfs:comment "Influences that are not directly controlled (e.g., ambient temperature, age of the pad)."@en .

cmpo:EPDThreshold a owl:DatatypeProperty;
  rdfs:domain cmpo:EndPointDetection;
  rdfs:range xsd:float;
  rdfs:comment "Threshold value used to determine end of polishing."@en .

cmpo:EndPointDetection a owl:Class;
  rdfs:comment "Methods and mechanisms used to determine when CMP polishing is complete."@en .

cmpo:EdgeAirBagZone a owl:Class;
  rdfs:subClassOf cmpo:Pressure, cmpo:PressureZone .

cmpo:EllipsometerTool a owl:Class;
  rdfs:subClassOf cmpo:MetrologyTool;
  rdfs:comment "Optical metrology tool that measures film thickness and optical constants (n, k) by analysing the polarisation state of reflected light. High accuracy for transparent thin films."@en .

cmpo:EngineeringLot a owl:Class;
  rdfs:subClassOf cmpo:LotType;
  rdfs:comment "Lot used for process development, recipe optimisation, DOE experiments or failure analysis. Not shipped to customers."@en .

cmpo:LotType a owl:Class;
  rdfs:comment "Classification of a wafer lot by its purpose in the production flow. Determines handling rules, measurement frequency and disposition criteria."@en .

cmpo:FTRTool a owl:Class;
  rdfs:subClassOf cmpo:MetrologyTool;
  rdfs:comment "Film Thickness and Reflectance (FTR) tool. Uses optical interferometry or reflectometry to measure thin film thickness and within-wafer uniformity at multiple measurement sites."@en .

cmpo:FinePolishing a owl:Class;
  rdfs:subClassOf cmpo:PolishingMode;
  rdfs:comment "Second polishing phase targeting final thickness and improved surface quality at a lower removal rate. Pad: softer; slurry: diluted or different formulation."@en .

cmpo:FrontSide a owl:Class;
  rdfs:subClassOf cmpo:WaferSide .

cmpo:HeadSpeedRPM a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:HeadSpeed, cmpo:Carrier;
  rdfs:range xsd:float .

cmpo:ImpedanceEPD a owl:Class;
  rdfs:subClassOf cmpo:EPDMethod;
  rdfs:comment "Electrical impedance-based end-point detection."@en .

cmpo:Inhibitor a owl:Class;
  rdfs:subClassOf cmpo:ChemicalAdditive;
  rdfs:comment "Chemical that forms a self-limiting protective layer on metal surfaces to prevent over-corrosion in recessed areas (e.g., BTA – benzotriazole – in Cu CMP). Key to minimising dishing."@en .

cmpo:Kelvin a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/K> .

cmpo:LinearCMPTool a owl:Class;
  rdfs:subClassOf cmpo:CMPToolType;
  rdfs:comment "CMP configuration using a linearly moving endless belt as the polishing pad. Enables constant relative velocity across the wafer. Examples: Speedfam-IPEC Avanti."@en .

cmpo:CMPToolType a owl:Class;
  rdfs:comment "Kinematic configuration of the CMP tool. Determines the nature of relative motion between the wafer and polishing pad and influences achievable uniformity profiles."@en .

cmpo:LinearMotion a owl:Class;
  rdfs:subClassOf cmpo:MotionProfile;
  rdfs:comment "Wafer head moves in a linear back-and-forth pattern."@en .

cmpo:MotionProfile a owl:Class;
  rdfs:comment "Pattern of motion applied to the wafer during CMP polishing."@en .

cmpo:MainOuterAirBagZone a owl:Class;
  rdfs:subClassOf cmpo:Pressure, cmpo:PressureZone .

cmpo:MaterialRemovalRate a owl:Class;
  rdfs:subClassOf cmpo:WaferMaterialRemovalRate, cmpo:DerivedParameter;
  rdfs:comment "Derived parameter representing material removal rate during CMP."@en .

cmpo:DerivedParameter a owl:Class;
  rdfs:subClassOf cmpo:MonitoringParameter;
  rdfs:comment "Explicitly marks parameters derived from other parameters, such as MRR."@en .

cmpo:Membrane a owl:Class;
  rdfs:subClassOf cmpo:Consumable .

cmpo:MembraneZone a owl:Class;
  rdfs:subClassOf cmpo:PressureZone .

cmpo:Micrometer a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/MicroM> .

cmpo:MilliliterPerMinute a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/MilliL-PER-MIN> .

cmpo:Minute a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/MIN> .

cmpo:Nanometer a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/NanoM> .

cmpo:NanometersPerMinute a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/NANOMETER_PER_MINUTE> .

cmpo:Newton a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/N> .

cmpo:OrbitalCMPTool a owl:Class;
  rdfs:subClassOf cmpo:CMPToolType;
  rdfs:comment "CMP configuration where the carrier head moves in an orbital (eccentric circular) pattern relative to the pad, while the platen also rotates. Examples: EBARA EPO series."@en .

cmpo:OrbitalMotion a owl:Class;
  rdfs:subClassOf cmpo:MotionProfile;
  rdfs:comment "Wafer head moves in a circular/orbital pattern on the polishing pad."@en .

cmpo:Overpolish a owl:Class;
  rdfs:subClassOf cmpo:CMPDefect;
  rdfs:comment "Excessive material removal beyond the intended stop layer."@en .

cmpo:Oxidizer a owl:Class;
  rdfs:subClassOf cmpo:ChemicalAdditive;
  rdfs:comment "Oxidising agent that forms a passivation layer on the metal surface enabling mechanical removal (e.g., H2O2 in Cu CMP, KIO3 in W CMP). Controls the chemical component of MRR."@en .

cmpo:PSI a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/PSI> .

cmpo:Percent a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/PERCENT> .

cmpo:PerforatedPad a owl:Class;
  rdfs:subClassOf cmpo:GroovePattern;
  rdfs:comment "Pad with through-holes (perforations) that enable in-situ optical end-point detection via the pad window."@en .

cmpo:PressureMeasurement a owl:Class;
  rdfs:subClassOf cmpo:Pressure, cmpo:MonitoringParameter;
  rdfs:comment "Actual pressure value measured during the process."@en, "Legacy Schema_v1 pressure-measurement class mapped into the v2 Pressure search category."@en .

cmpo:MonitoringParameter a owl:Class;
  rdfs:subClassOf cmpo:Parameter;
  rdfs:comment "Sensor values measured during the process (e.g., motor current, vibration)."@en .

cmpo:PressureParameter a owl:Class;
  rdfs:subClassOf cmpo:Pressure, _:node48 .

cmpo:Bar a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/BAR> .

cmpo:PressureSetPoint a owl:Class;
  rdfs:subClassOf cmpo:Pressure, cmpo:ProcessParameter;
  rdfs:comment "Target pressure value in the recipe."@en .

cmpo:ProcessParameter a owl:Class;
  rdfs:subClassOf cmpo:Parameter;
  rdfs:comment "Values specified by the engineer in the recipe (e.g., pressure, speed)."@en .

cmpo:PressurizedSheet a owl:Class;
  rdfs:subClassOf cmpo:Consumable .

cmpo:PrimaryFlat a owl:Class;
  rdfs:subClassOf cmpo:WaferNotch;
  rdfs:comment "Flat section ground on the wafer edge, indicating the crystallographic orientation. Standard for 100 mm and 150 mm wafers. The flat causes edge non-uniformity near its location."@en .

cmpo:WaferNotch a owl:Class;
  rdfs:comment "Mechanical alignment feature on the wafer edge used to establish the angular orientation of the wafer in the carrier and on metrology stages. Critical for correct polishing and measurement site alignment."@en .

cmpo:ProductionLot a owl:Class;
  rdfs:subClassOf cmpo:LotType;
  rdfs:comment "Regular production lot containing customer product wafers. Processed according to the released production recipe."@en .

cmpo:ProfilometerTool a owl:Class;
  rdfs:subClassOf cmpo:MetrologyTool;
  rdfs:comment "Contact or optical surface profiler. Measures step heights, dishing (mm-scale depression of metal lines) and erosion (large-area thinning of dielectric) after CMP."@en .

cmpo:QualificationLot a owl:Class;
  rdfs:subClassOf cmpo:LotType;
  rdfs:comment "Lot processed to validate a new recipe, tool configuration, consumable change or equipment qualification before release to production."@en .

cmpo:RPM a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/V_REV-PER-MIN> .

cmpo:RelativeVelocity a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Step, cmpo:RelativeVelocityParameter;
  rdfs:range xsd:float;
  rdfs:comment "Relative velocity between the wafer and polishing pad surface, calculated from platen and carrier speeds, measured in m/s."@en .

cmpo:RetainingRingZone a owl:Class;
  rdfs:subClassOf cmpo:Pressure, cmpo:PressureZone .

cmpo:RippleAirBagZone a owl:Class;
  rdfs:subClassOf cmpo:Pressure, cmpo:PressureZone .

cmpo:RotaryCMPTool a owl:Class;
  rdfs:subClassOf cmpo:CMPToolType;
  rdfs:comment "Most common CMP configuration: both the platen and the carrier head rotate independently. The relative velocity depends on both RPMs. Examples: AMAT Mirra, Reflexion LK, Novellus SABRE."@en .

cmpo:SEMTool a owl:Class;
  rdfs:subClassOf cmpo:MetrologyTool;
  rdfs:comment "Scanning Electron Microscopy (SEM) tool. Provides high-resolution surface imaging for scratch detection, particle contamination analysis and cross-section inspection after CMP."@en .

cmpo:Second a cmpo:Unit;
  owl:sameAs <http://qudt.org/vocab/unit/SEC> .

cmpo:Service a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015>;
  rdfs:comment "According to the process card, Service is the label for a general step or operator group in the whole (chip-)production process like CMP, PVD or ALD."@en .

cmpo:SilicaAbrasive a owl:Class;
  rdfs:subClassOf cmpo:AbrasiveType;
  rdfs:comment "Silicon dioxide (SiO2) abrasive particles. Most widely used; applied in oxide, STI and polysilicon CMP. Mohs hardness ~7."@en .

cmpo:SpiralGroove a owl:Class;
  rdfs:subClassOf cmpo:GroovePattern;
  rdfs:comment "Spiral groove pattern on the pad surface; promotes centrifugal slurry transport outward from pad centre."@en .

cmpo:Surfactant a owl:Class;
  rdfs:subClassOf cmpo:ChemicalAdditive;
  rdfs:comment "Surface-active agent added to slurry to improve wettability, reduce abrasive agglomeration, control friction coefficient and minimise scratch defectivity."@en .

cmpo:ToolID a owl:DatatypeProperty;
  rdfs:domain cmpo:Tool, cmpo:Step;
  rdfs:range xsd:string;
  rdfs:comment "Identifies the specific tool used in a CMP step (e.g., 'CMP_Tool_001'). Applied to both Step and Tool."@en .

cmpo:Underpolish a owl:Class;
  rdfs:subClassOf cmpo:CMPDefect;
  rdfs:comment "Insufficient material removal, leaving residual material on the surface."@en .

cmpo:VNotch a owl:Class;
  rdfs:subClassOf cmpo:WaferNotch;
  rdfs:comment "V-shaped notch on the wafer edge. SEMI standard for 200 mm and 300 mm wafers. The retaining ring must accommodate the notch to prevent rotation during polishing."@en .

cmpo:WIWNonUniformity a owl:Class;
  rdfs:subClassOf cmpo:MonitoringParameter;
  rdfs:comment "Within-Wafer Non-Uniformity (WIWNU): the percentage range or standard deviation of post-CMP film thickness measured at multiple sites across a single wafer surface. A key CMP quality KPI."@en .

cmpo:WaferStatus a owl:Class;
  rdfs:comment "Represents the normative status of a wafer in the process. From old process card: x=to be done; 0=not done; 1=finished; 2=tool error; 3=wafer out of spec; 4=wafer crashed."@en .

cmpo:WaferToWaferUniformity a owl:Class;
  rdfs:subClassOf cmpo:MonitoringParameter;
  rdfs:comment "Wafer-to-Wafer Uniformity (WTWU): variation in mean removal rate or post-CMP thickness across all wafers in a lot. Indicates process stability over time."@en .

cmpo:XYGroove a owl:Class;
  rdfs:subClassOf cmpo:GroovePattern;
  rdfs:comment "Orthogonal (Cartesian) grid groove pattern. Provides uniform slurry distribution in both x and y directions."@en .

cmpo:actualRemovalAmount a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:WaferMaterialRemovalRate, cmpo:WaferState;
  rdfs:range xsd:float;
  rdfs:comment "Actual thickness of material removed after CMP, in nanometers (nm). Computed from pre-CMP and post-CMP thickness measurements."@en .

cmpo:WaferState a owl:Class;
  rdfs:comment "Wafer State describes the physical state of the wafer and its properties through time."@en .

cmpo:additiveConcentration a owl:DatatypeProperty;
  rdfs:domain cmpo:ChemicalAdditive;
  rdfs:range xsd:float;
  rdfs:comment "Concentration of the additive in the slurry solution (% by weight or volume)."@en .

cmpo:atTime a owl:DatatypeProperty;
  rdfs:range xsd:dateTime;
  rdfs:comment "Timestamp property; applicable to Measurement and Step instances."@en .

cmpo:cleaningDuration a owl:DatatypeProperty;
  rdfs:domain cmpo:PostCMPCleaning;
  rdfs:range xsd:float;
  rdfs:comment "Duration of the post-CMP cleaning process in seconds."@en .

cmpo:PostCMPCleaning a owl:Class;
  rdfs:comment "Cleaning step performed after CMP polishing to remove residual slurry and contaminants."@en .

cmpo:cleaningTemperature a owl:DatatypeProperty;
  rdfs:domain cmpo:PostCMPCleaning;
  rdfs:range xsd:float;
  rdfs:comment "Temperature of the cleaning solution in degrees Celsius."@en .

cmpo:cleanroomHumidity a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:EnvironmentalCondition, cmpo:CleanroomParameter;
  rdfs:range xsd:float;
  rdfs:comment "Relative humidity of the cleanroom environment (%). Typical target: 45 ± 5%."@en .

cmpo:EnvironmentalCondition a owl:Class;
  rdfs:comment "Ambient cleanroom conditions recorded at the time of CMP processing. Affects slurry chemistry stability, pad mechanical properties and process repeatability."@en .

cmpo:cleanroomTemperature a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:EnvironmentalCondition, cmpo:CleanroomParameter;
  rdfs:range xsd:float;
  rdfs:comment "Ambient air temperature inside the cleanroom in degrees Celsius. Typical target: 22 ± 0.5 °C."@en .

cmpo:conditionerWaterStatus a owl:DatatypeProperty;
  rdfs:domain cmpo:ConditionerTable;
  rdfs:range xsd:decimal;
  rdfs:comment "Amount of deionized water used for rinsing and cooling the dresser/conditioner."@en .

cmpo:ConditionerTable a owl:Class;
  rdfs:subClassOf cmpo:Conditioning, cmpo:ToolComponent;
  rdfs:comment "Conditioner table is the parking position for the conditioner and where it is cleaned."@en .

cmpo:conditioningMode a owl:DatatypeProperty;
  rdfs:domain cmpo:Conditioner;
  rdfs:range xsd:string;
  rdfs:comment "Mode of pad conditioning: 'in-situ' (concurrent with polishing, maintains steady-state pad surface) or 'ex-situ' (between wafer runs, more aggressive pad renewal)."@en .

cmpo:conditioningRatio a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Conditioning, cmpo:Conditioner;
  rdfs:range xsd:float;
  rdfs:comment "Ratio of total conditioning time to total polishing time within a run (%). Higher ratio leads to more aggressive pad renewal and typically higher MRR."@en .

cmpo:derivationFormula a owl:DatatypeProperty;
  rdfs:domain cmpo:DerivedParameter;
  rdfs:range xsd:string;
  rdfs:comment "Describes the formula used to compute a derived parameter."@en .

cmpo:derivedFrom a owl:ObjectProperty;
  rdfs:domain cmpo:DerivedParameter;
  rdfs:range cmpo:Parameter;
  rdfs:comment "Links a derived parameter to its source parameters (monitoring or process)."@en .

cmpo:discConditioningForce a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Conditioning, cmpo:ConditionerDisc;
  rdfs:range xsd:float;
  rdfs:comment "Normal force applied by the conditioner disc on the polishing pad surface, measured in Newtons (N). Higher force increases pad removal rate and asperity density."@en .

cmpo:ConditionerDisc a owl:Class;
  rdfs:subClassOf cmpo:Conditioning, cmpo:Consumable;
  rdfs:comment "Diamond-embedded disc mounted on the conditioner arm. Regenerates the micro-texture (asperities) of the polishing pad surface by abrasive dressing."@en .

cmpo:discDiamondGrade a owl:DatatypeProperty;
  rdfs:domain cmpo:ConditionerDisc;
  rdfs:range xsd:string;
  rdfs:comment "Grit grade or mesh size of the embedded diamond particles (e.g., '#100', 'mesh 80–100'). Finer grit gives smoother pad surface and lower scratch risk."@en .

cmpo:discRotationSpeed a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Conditioning, cmpo:ConditionerDisc;
  rdfs:range xsd:float;
  rdfs:comment "Rotation speed of the conditioner disc in RPM during pad dressing."@en .

cmpo:dwellTime a owl:DatatypeProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range xsd:float;
  rdfs:comment "Time in seconds that the wafer spends on the polishing pad during a single pass."@en .

cmpo:edgeExclusion a owl:DatatypeProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range xsd:float;
  rdfs:comment "Width of the annular zone at the wafer edge (in mm) excluded from process specifications and metrology. Typical values: 2 mm (300 mm wafers) to 5 mm (150 mm wafers). The exclusion zone is prone to non-uniform polishing near the retaining ring."@en .

cmpo:executedOn a owl:ObjectProperty;
  rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000057>;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:Tool;
  rdfs:comment "Process card or MES provides information about which tool is used for a specific step (e.g., ArdenneCS400S or 2THI_CMP_ME_Cu_6Z_)."@en .

cmpo:fromStep a owl:ObjectProperty;
  rdfs:domain cmpo:Measurement;
  rdfs:range cmpo:Step .

cmpo:grooveDepth a owl:DatatypeProperty;
  rdfs:domain cmpo:GroovePattern;
  rdfs:range xsd:float;
  rdfs:comment "Depth of pad grooves in millimetres. Groove depth decreases with pad wear; a pad is typically replaced when grooves are worn below a minimum depth threshold."@en .

cmpo:grooveWidth a owl:DatatypeProperty;
  rdfs:domain cmpo:GroovePattern;
  rdfs:range xsd:float;
  rdfs:comment "Width of pad grooves in millimetres."@en .

cmpo:hasAbrasiveType a owl:ObjectProperty;
  rdfs:domain cmpo:Slurry;
  rdfs:range cmpo:AbrasiveType;
  rdfs:comment "Specifies the abrasive particle material used in the CMP slurry."@en .

cmpo:hasAdditive a owl:ObjectProperty;
  rdfs:domain cmpo:Slurry;
  rdfs:range cmpo:ChemicalAdditive;
  rdfs:comment "Connects a slurry formulation to its chemical additives."@en .

cmpo:hasChemistry a owl:ObjectProperty;
  rdfs:domain cmpo:Slurry;
  rdfs:range cmpo:SlurryChemistry;
  rdfs:comment "Links a slurry to its chemical properties and composition."@en .

cmpo:SlurryChemistry a owl:Class;
  rdfs:comment "Chemical composition and properties of the CMP slurry."@en .

cmpo:hasCleaningStep a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:PostCMPCleaning;
  rdfs:comment "Links a polishing step to its post-CMP cleaning process."@en .

cmpo:hasComponent a owl:ObjectProperty;
  rdfs:domain cmpo:Carrier;
  rdfs:range cmpo:ToolComponent .

cmpo:hasConditionerDisc a owl:ObjectProperty;
  rdfs:domain cmpo:Conditioner;
  rdfs:range cmpo:ConditionerDisc;
  rdfs:comment "Links the conditioner arm to its replaceable diamond conditioning disc."@en .

cmpo:hasConditioningSweepRate a owl:DatatypeProperty;
  rdfs:domain cmpo:Conditioner;
  rdfs:range xsd:integer;
  rdfs:comment "The frequency of the conditioner arm movement across the pad, measured in sweeps per minute (SPM)."@en .

cmpo:hasDefectArea a owl:DatatypeProperty;
  rdfs:domain cmpo:DefectType;
  rdfs:range xsd:float;
  rdfs:comment "Area of the defect in square micrometers (µm²)."@en .

cmpo:DefectType a owl:Class;
  rdfs:comment "Classification of defects that can occur during CMP process."@en .

cmpo:hasDefectType a owl:ObjectProperty;
  rdfs:domain cmpo:WaferState;
  rdfs:range cmpo:DefectType;
  rdfs:comment "Associates a detected defect type with a wafer state."@en .

cmpo:hasDownforce a owl:DatatypeProperty;
  rdfs:domain cmpo:Step;
  rdfs:range xsd:float;
  rdfs:comment "Vertical force applied by the carrier head on the wafer during polishing, typically measured in Newtons (N)."@en .

cmpo:hasEnvironmentalCondition a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:EnvironmentalCondition;
  rdfs:comment "Associates a process step with the ambient environmental conditions recorded during its execution."@en .

cmpo:hasFeedbackParameter a owl:ObjectProperty;
  rdfs:domain cmpo:RunToRunControl;
  rdfs:range cmpo:MonitoringParameter;
  rdfs:comment "The measured output parameter used as feedback signal in the R2R controller (e.g., post-CMP film thickness, WIWNU)."@en .

cmpo:RunToRunControl a owl:Class;
  rdfs:comment "Advanced Process Control (APC) strategy that adjusts recipe set-points between wafer runs based on measured output feedback, keeping the process on target despite drift in pad wear, slurry ageing and tool state."@en .

cmpo:hasFeedforwardParameter a owl:ObjectProperty;
  rdfs:domain cmpo:RunToRunControl;
  rdfs:range cmpo:ProcessParameter;
  rdfs:comment "The recipe set-point adjusted by the R2R controller between runs (e.g., polishing time, downforce). The controller computes the adjustment from the feedback error."@en .

cmpo:hasGroovePattern a owl:ObjectProperty;
  rdfs:domain cmpo:PolishingPad;
  rdfs:range cmpo:GroovePattern;
  rdfs:comment "Specifies the groove geometry of this polishing pad instance."@en .

cmpo:hasIndexValue a owl:DatatypeProperty, owl:FunctionalProperty;
  rdfs:domain cmpo:WaferID;
  rdfs:range xsd:integer;
  rdfs:comment "WaferId is an integer number between 1 and 25. The waferId is the position of the wafer within the wafer box."@en .

cmpo:WaferID a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030>;
  rdfs:comment "WaferID is a unique identifier for a Wafer."@en .

cmpo:hasInput a owl:ObjectProperty;
  rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002233>;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:Wafer .

cmpo:hasInstruction a owl:ObjectProperty;
  rdfs:domain cmpo:Recipe;
  rdfs:range cmpo:ProcessParameter .

cmpo:hasLifetime a owl:DatatypeProperty;
  rdfs:domain cmpo:Consumable;
  rdfs:range xsd:string .

cmpo:hasLotNumber a owl:DatatypeProperty, owl:FunctionalProperty;
  rdfs:domain cmpo:Lot;
  rdfs:range xsd:string;
  rdfs:comment "Every wafer lot has a specific lot number formatted like 400-111."@en .

cmpo:hasLotType a owl:ObjectProperty;
  rdfs:domain cmpo:Lot;
  rdfs:range cmpo:LotType .

cmpo:Material a owl:Class .

cmpo:hasMaterialName a owl:DatatypeProperty;
  rdfs:domain cmpo:Material;
  rdfs:range xsd:string .

cmpo:hasMaterialRemovalRate a owl:DatatypeProperty;
  rdfs:domain cmpo:Step;
  rdfs:range xsd:float .

cmpo:hasMaxValue a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasUpperLimit;
  rdfs:domain cmpo:ProcessWindow;
  rdfs:range xsd:float .

cmpo:ProcessWindow a owl:Class .

cmpo:hasMeasuredValue a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:PressureZone;
  rdfs:range xsd:float .

cmpo:hasMinValue a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasLowerLimit;
  rdfs:domain cmpo:ProcessWindow;
  rdfs:range xsd:float .

cmpo:hasMotionProfile a owl:ObjectProperty;
  rdfs:domain cmpo:Carrier;
  rdfs:range cmpo:MotionProfile .

cmpo:hasNextStep a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:Step .

cmpo:hasNotch a owl:ObjectProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range cmpo:WaferNotch .

cmpo:hasNumber a owl:DatatypeProperty;
  rdfs:domain cmpo:Chamber;
  rdfs:range xsd:integer .

cmpo:hasOrientation a owl:ObjectProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range cmpo:CrystallographicOrientation .

cmpo:CrystallographicOrientation a owl:Class .

cmpo:hasOutput a owl:ObjectProperty;
  rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002234>;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:Wafer .

cmpo:hasPolishingMode a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:PolishingMode .

cmpo:hasPosition a owl:DatatypeProperty;
  rdfs:domain cmpo:PressureZone;
  rdfs:range xsd:integer .

cmpo:hasProcessOwnerRole a owl:ObjectProperty;
  rdfs:subPropertyOf cmpo:hasRole;
  rdfs:range cmpo:ProcessOwner .

cmpo:ProcessOwner a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

cmpo:hasProcessWindow a owl:ObjectProperty;
  rdfs:domain cmpo:Parameter;
  rdfs:range cmpo:ProcessWindow .

cmpo:hasProjectName a owl:DatatypeProperty;
  rdfs:domain cmpo:Project;
  rdfs:range xsd:string .

cmpo:hasProjectOwnerRole a owl:ObjectProperty;
  rdfs:subPropertyOf cmpo:hasRole;
  rdfs:range cmpo:ProjectOwner .

cmpo:ProjectOwner a owl:Class;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> .

cmpo:hasQualificationStatus a owl:DatatypeProperty;
  rdfs:domain cmpo:Tool;
  rdfs:range xsd:string .

cmpo:hasRotationSpeed a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Velocity, cmpo:Platen;
  rdfs:range xsd:float .

cmpo:hasRoughness a owl:DatatypeProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range xsd:float .

cmpo:hasSPCLimit a owl:ObjectProperty;
  rdfs:domain cmpo:Parameter;
  rdfs:range cmpo:SPCLimit .

cmpo:SPCLimit a owl:Class .

cmpo:hasSelectivity a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:MaterialSelectivity .

cmpo:MaterialSelectivity a owl:Class .

cmpo:hasSetPoint a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Pressure, cmpo:PressureZone;
  rdfs:range xsd:float .

cmpo:hasSlurryFlowRate a owl:ObjectProperty;
  rdfs:domain cmpo:SlurryPipe;
  rdfs:range cmpo:SlurryFlowRate .

cmpo:SlurryFlowRate a owl:Class;
  rdfs:subClassOf cmpo:Parameter, cmpo:SlurryFlow .

cmpo:hasStepIndex a owl:DatatypeProperty, owl:FunctionalProperty;
  rdfs:domain cmpo:Step;
  rdfs:range xsd:integer .

cmpo:hasSubstrate a owl:ObjectProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range cmpo:Material .

cmpo:hasThickness a owl:DatatypeProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range xsd:float .

cmpo:hasToolType a owl:ObjectProperty;
  rdfs:domain cmpo:Tool;
  rdfs:range cmpo:CMPToolType .

cmpo:hasUniformity a owl:DatatypeProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range xsd:float .

cmpo:hasUsageCount a owl:DatatypeProperty;
  rdfs:domain cmpo:UsageTracking;
  rdfs:range xsd:float .

cmpo:UsageTracking a owl:Class .

cmpo:hasUsageTime a owl:DatatypeProperty;
  rdfs:domain cmpo:UsageTracking;
  rdfs:range xsd:float .

cmpo:hasUsageType a owl:DatatypeProperty;
  rdfs:domain cmpo:UsageTracking;
  rdfs:range xsd:string .

cmpo:hasValue a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Parameter;
  rdfs:range xsd:float .

cmpo:hasWIWNU a owl:DatatypeProperty;
  rdfs:domain cmpo:WaferState;
  rdfs:range xsd:float .

cmpo:hasWTWU a owl:DatatypeProperty;
  rdfs:domain cmpo:Lot;
  rdfs:range xsd:float .

cmpo:hasWaferID a owl:ObjectProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range cmpo:WaferID .

cmpo:ionicStrength a owl:DatatypeProperty;
  rdfs:domain cmpo:Slurry;
  rdfs:range xsd:float .

cmpo:isStateOf a owl:ObjectProperty;
  rdfs:domain cmpo:WaferState;
  rdfs:range cmpo:Wafer .

cmpo:ispartof a owl:ObjectProperty;
  rdfs:domain cmpo:Wafer;
  rdfs:range cmpo:Lot .

cmpo:lowerControlLimit a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasLowerLimit;
  rdfs:domain cmpo:SPCLimit;
  rdfs:range xsd:float .

cmpo:lowerSpecLimit a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasLowerLimit;
  rdfs:domain cmpo:SPCLimit;
  rdfs:range xsd:float .

cmpo:measuredValue a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:WaferMaterialRemovalRate, cmpo:Measurement;
  rdfs:range xsd:float .

cmpo:numberOfZones a owl:AnnotationProperty .

cmpo:orientationPlane a owl:DatatypeProperty;
  rdfs:domain cmpo:CrystallographicOrientation;
  rdfs:range xsd:string .

cmpo:padCompressibility a owl:DatatypeProperty;
  rdfs:domain cmpo:PolishingPad;
  rdfs:range xsd:float .

cmpo:padHardness a owl:DatatypeProperty;
  rdfs:domain cmpo:PolishingPad;
  rdfs:range xsd:float .

cmpo:padLifetimeMinutes a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:PadLifetime, cmpo:PolishingPad;
  rdfs:range xsd:float .

cmpo:padLifetimeWaferCount a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:PadLifetime, cmpo:PolishingPad;
  rdfs:range xsd:integer .

cmpo:particleConcentration a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Slurry, cmpo:SlurryChemistryParameter;
  rdfs:range xsd:float .

cmpo:particleSize a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Slurry, cmpo:SlurryChemistryParameter;
  rdfs:range xsd:float .

cmpo:polishingDuration a owl:DatatypeProperty;
  rdfs:domain cmpo:Step;
  rdfs:range xsd:float .

cmpo:polishingEndTime a owl:DatatypeProperty;
  rdfs:domain cmpo:Step;
  rdfs:range xsd:dateTime .

cmpo:polishingStartTime a owl:DatatypeProperty;
  rdfs:domain cmpo:Step;
  rdfs:range xsd:dateTime .

cmpo:prestonCoefficient a owl:DatatypeProperty;
  rdfs:domain cmpo:Step;
  rdfs:range xsd:float .

cmpo:primaryMaterial a owl:ObjectProperty;
  rdfs:domain cmpo:MaterialSelectivity;
  rdfs:range cmpo:Material .

cmpo:relativeVelocityFormula a owl:DatatypeProperty;
  rdfs:domain cmpo:Step;
  rdfs:range xsd:string .

cmpo:runsOnPlaten a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:Platen .

cmpo:seasoningDate a owl:DatatypeProperty;
  rdfs:domain cmpo:Tool;
  rdfs:range xsd:dateTime .

cmpo:secondaryMaterial a owl:ObjectProperty;
  rdfs:domain cmpo:MaterialSelectivity;
  rdfs:range cmpo:Material .

cmpo:selectivityRatio a owl:DatatypeProperty;
  rdfs:domain cmpo:MaterialSelectivity;
  rdfs:range xsd:float .

cmpo:slurryBatch a owl:DatatypeProperty;
  rdfs:domain cmpo:Slurry;
  rdfs:range xsd:string .

cmpo:slurryDilutionRatio a owl:DatatypeProperty;
  rdfs:domain cmpo:Slurry;
  rdfs:range xsd:float .

cmpo:slurryFlowRateValue a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:SlurryFlow, cmpo:SlurryPipe;
  rdfs:range xsd:float .

cmpo:slurryPH a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Slurry, cmpo:SlurryChemistryParameter;
  rdfs:range xsd:float .

cmpo:slurryViscosity a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Slurry, cmpo:SlurryChemistryParameter;
  rdfs:range xsd:float .

cmpo:solidContent a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Slurry, cmpo:SlurryChemistryParameter;
  rdfs:range xsd:float .

cmpo:targetLayerThickness a owl:DatatypeProperty;
  rdfs:domain cmpo:ProcessCard;
  rdfs:range xsd:float .

cmpo:targetRemovalAmount a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:WaferMaterialRemovalRate, cmpo:ProcessCard;
  rdfs:range xsd:float .

cmpo:targetUniformity a owl:DatatypeProperty;
  rdfs:domain cmpo:ProcessCard;
  rdfs:range xsd:float .

cmpo:targetValue a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:SPCLimit;
  rdfs:range xsd:float .

cmpo:targetsSide a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:WaferSide .

cmpo:temperatureInC a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:PolishingPad, cmpo:TemperatureParameter;
  rdfs:range xsd:float .

cmpo:tracksComponent a owl:ObjectProperty;
  rdfs:domain cmpo:UsageTracking;
  rdfs:range cmpo:ToolComponent .

cmpo:undergoesQualification a owl:ObjectProperty;
  rdfs:domain cmpo:Tool;
  rdfs:range cmpo:ToolQualification .

cmpo:ToolQualification a owl:Class .

cmpo:uniformityTolerance a owl:DatatypeProperty;
  rdfs:domain cmpo:ProcessCard;
  rdfs:range xsd:float .

cmpo:upperControlLimit a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasUpperLimit;
  rdfs:domain cmpo:SPCLimit;
  rdfs:range xsd:float .

cmpo:upperSpecLimit a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasUpperLimit;
  rdfs:domain cmpo:SPCLimit;
  rdfs:range xsd:float .

cmpo:usedSlurry a owl:ObjectProperty;
  rdfs:domain cmpo:WaferState;
  rdfs:range cmpo:Slurry .

cmpo:usesEPDMethod a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:EPDMethod .

cmpo:usesPrestonModel a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:PrestonEquation .

cmpo:PrestonEquation a owl:Class .

cmpo:usesRTRControl a owl:ObjectProperty;
  rdfs:domain cmpo:Step;
  rdfs:range cmpo:RunToRunControl .

cmpo:zetaPotential a owl:DatatypeProperty;
  rdfs:subPropertyOf cmpo:hasNumericValue;
  rdfs:domain cmpo:Slurry, cmpo:SlurryChemistryParameter;
  rdfs:range xsd:float .

cmpo:hasPressureZone a owl:ObjectProperty;
  rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000051>;
  rdfs:domain cmpo:Carrier;
  rdfs:range cmpo:PressureZone .

cmpo:hasUsageId a owl:DatatypeProperty;
  rdfs:domain cmpo:UsageTracking;
  rdfs:range xsd:string .

_:node47 a owl:Restriction .

_:node48 a owl:Restriction .

cmpo:RelativeVelocityParameter a owl:Class;
  rdfs:subClassOf cmpo:Velocity .

cmpo:CleanroomParameter a owl:Class;
  rdfs:subClassOf cmpo:Parameter .

