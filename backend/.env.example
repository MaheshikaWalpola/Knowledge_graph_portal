# Copy to backend/.env and fill in the values. git ignores .env, so a pull never overwrites it.
# See READMe.md (Local Setup Guide, Production Deployment) for what each value means.

# --- GraphDB ---
GRAPHDB_BASE_URL=http://localhost:7200
GRAPHDB_REPOSITORY=CMP
CMP_NS=https://tucid/cmpo/
CMP_INSTANCE_NS=https://tucid/cmpo/instance/
BASE_SCHEMA_GRAPH=https://tucid/cmpo/base
BASE_INSTANCE_GRAPH=https://tucid/cmpo/graph/base-instances

# --- MongoDB (users, workspaces, history, generation log, timing log) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=kg_portal

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# --- Frontend and CORS ---
# local:      http://localhost:5173
# production: FRONTEND_BASE_URL=https://vsr.informatik.tu-chemnitz.de/knowledgegraphportal
#             CORS_ORIGINS=https://vsr.informatik.tu-chemnitz.de
#             API_ROOT_PATH=/knowledgegraphportal/api
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_ROOT_PATH=

# --- E-mail (optional; verification and password-reset mails) ---
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# --- AI models ---
# Kiste (TU Chemnitz server) is always used. The model list the dropdowns show is
# backend/models.yaml merged with GET <KISTE_BASE_URL>/v1/models at startup.
KISTE_API_URL=https://kiste.informatik.tu-chemnitz.de/v1/chat/completions
KISTE_BASE_URL=https://kiste.informatik.tu-chemnitz.de
KISTE_API_KEY=
KISTE_MODEL=Qwen3.6-35B-A3B-MLX-8bit
# Cloud providers: the Claude / OpenAI models appear in the dropdowns only when the key is set
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional tuning (defaults shown) ---
# KISTE_TIMEOUT=300                  seconds per model call
# KISTE_MAX_PARALLEL=3               shapes generated at once (Kiste queues extra requests)
# KISTE_VERIFY_REASONING_EFFORT=     reasoning effort passed to the verification model, if it supports one
# ENABLE_SHACL_VERIFICATION=true     set to false to switch the AI verification step off
