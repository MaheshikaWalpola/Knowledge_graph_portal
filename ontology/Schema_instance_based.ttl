@prefix : <file:///Users/apet/Desktop/vsr_ontology/ontology/schema/Schema_instance_based.ttl#> .
@prefix : <https://tucid/cpmo/schema#> .
@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix cmpo: <https://tucid/cpmo/> .
@prefix example: <http://www.example.org/rdf#> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xmlns: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

#################################################################
### Ontology Header
#################################################################

<https://tucid/cpmo/schema> rdf:type owl:Ontology ;
    rdfs:comment "CMP Schema-Level Ontology aligned with BFO (TBox + schema connections)" .

#################################################################
### Core Concept Wafer
#################################################################
cmpo:Wafer           rdfs:subClassOf BFO:0000030 . 

cmpo:Layer a rdfs:Class . 
cmpo:DummyWafer rdfs:subClassOf cmpo:Wafer ;
rdfs:comment 'DummyWafer are pure Silicon Wafer. DummyWafer are used to break-in tools before actual use oder to check tool functionality after equipment change or so' .
cmpo:ControlWafer rdfs:subClassOf cmpo:Wafer ;
rdfs:label "Control Wafer"@en , "Kontrollwafer"@de ;
    skos:altLabel "K-Scheibe"@de ;
    rdfs:comment 'ControlWafer are unstructured Wafer in a specific WaferLot ControlWafer are used to measure wafer properties as uniformity, roughness before the polishing process. They are used to calculate the MRR' . 
cmpo:StructuredWafer rdfs:subClassOf cmpo:Wafer ;
rdfs:comment 'StructuredWafer are Wafer in a WaferLot with Layout for actual production. tructuredWafer are the main process wafer, which might not be measured by using non-distructive methodes (eg. optical methods)' .

    cmpo:hasWaferID a owl:ObjectProperty ;
    rdfs:domain cmpo:Wafer ; 
    rdfs:range cmpo:WaferID .  
cmpo:WaferID rdfs:subClassOf iao:InformationContentEntity . #Maheshika would you fix this please

cmpo:WaferState a owl:Class ;
    rdfs:label "Wafer State"@en ;
    rdfs:comment: 'Wafer State decribes the physical State of the wafer and its properties through the time.' .

    cmpo:hasTimestamp a owl:DatatypeProperty ;
     rdfs:domain cmpo:WaferState ;
     rdfs:range xsd:dateTime .

    cmpo:isStateOf a owl:ObjectProperty ;
    rdfs:domain cmpo:Wafer ;
    rdfs:range cmpo:WaferState.
    

    cmpo:ispartof a owl:ObjectProperty ; 
    rdfs:domain cmpo:WaferID ;
    rdfs:range cmpo:Lot .

    cmpo:hasIndexValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain cmpo:WaferID ;
    rdfs:comment 'WaferId is a interger number between 1 and 25. The waferId is the position of the wafer within the wafer box' ;
    rdfs:range xsd:integer . 

cmpo:Lot rdfs:subClassOf BFO:0000030 .

    cmpo:hasLotNumber  a owl:DatatypeProperty, owl:FunctionalProperty ; 
    rdfs:domain cmpo:Lot ;
    rdfs:comment 'every wafer lot has a specific lot number formated like 400-111' ;
    rdfs:range xsd:string  . 

cmpo:Project a rdfs:Class .

    cmpo:hasProjectName a owl:DatatypeProperty ;
    rdfs:domain cmpo:Project ;
    rdfs:comment 'Every Wafer and every Lot belongs to a specific Project. for Dummy wafer the Project is called Dummy. for all other projects it is a name or a project number. Example: Project: XENA' ;
    rdfs:range xsd:string .

#wafer properties

    cmpo:hasDiameter a owl:DatatypeProperty ; #wo wird definiert, das richtige Einheit angezeigt wird?
    rdfs:domain cmpo:Wafer ;
    rdfs:comment 'Wafer diameter is given either in inch oder mm. most common: 150 mm (6 inch), 200 mm (8 inch), 300 mm (12 inch)' ;
    rdfs:range xsd:float .

   # cmpo:hasThickness a owl:DatatypeProperty ;
   # rdfs:domain cmpo:Wafer ;
   # rdfs:comment 'wafer thickness is given in mircometer or nanometer. 130 mircometer' ;
   # rdfs:range xsd:float .

    cmpo:hasThickness a owl:DatatypeProperty ;
    rdfs:comment 'Applies to all values for thickness as wafer thickenss or layer thickness.' ;
    rdfs:range xsd:float .

    cmpo:hasRoughness a owl:DatatypeProperty ;
    rdfs:range xsd:float . 

    cmpo:hasUniformity a owl:DatatypeProperty ;
    rdfs:range xsd:float . 

    cmpo:hasLayer a owl:ObjectProperty ;
    rdfs:domain cmpo:Wafer ;
    rdfs:comment 'Layer is a specific material and layout the wafer has. Structured wafer could have multiple layers. Dummy wafer don`t have layers' ;
    rdfs:range cmpo:Layer . 

    cmpo:hasMaterial a owl:ObjectProperty ; #klären, wie definiert wird, welcehr layer für die bearbeitung des Prozesses relevant ist. MAterial als Klasse, um generalisierbarer zu sien?
    rdfs:domain cmpo:Layer ; 
    rdfs:range cmpo:Material .

cmpo:WaferSide a rdfs:Class .

cmpo:FrontSide a cmpo:WaferSide .
cmpo:BackSide a cmpo:WaferSide .

cmpo:targetsSide a owl:ObjectProperty ;
    rdfs:domain cmpo:Step ;
    rdfs:range cmpo:WaferSide ;
    rdfs:comment "defines which wafer side has to be processed." .

cmpo:Material  a rdfs:Class .

    cmpo:hasMaterialName a owl:DatatypeProperty ;
    rdfs:range xsd:string . 

    #cmpo:hasMaterialName a owl:DatatypeProperty ;  
    #rdfs:domain cmpo:Layer ; 
    #rdfs:range xsd:string .
    
    #cmpo:hasMaterialName a owl:DatatypeProperty ;  
    #rdfs:domain cmpo:Material ; 
    #rdfs:range xsd:string .
     
    cmpo:hasSubstrate a owl:ObjectProperty ;
    rdfs:domain cmpo:Wafer ;
    rdfs:comment 'substrate is the Material the pure wafer is made from. In most cases this is Silicon.' ;
    rdfs:range cmpo:Material .

#cmpo:WaferState a owl:Class ;
 #   rdfs:label "Wafer State"@en .

  #  cmpo:describesWaferAt a owl:ObjectProperty ;
  #  rdfs:domain cmpo:WaferState ;
   # rdfs:range cmpo:Wafer .
    
cmpo:WaferStatus a owl:Class ;
    rdfs:label "Wafer Status"@en ;
    rdfs:comment "represents the normative status of wafer in the process # from old process card: x=to be done; 0=not done; 1=finshed; 2=tool error;3= wafer out of spec; 4=wafer crashed." .

    cmpo:hasStatus a owl:DatatypeProperty ;
    rdfs:domain cmpo:Wafer ;
    rdfs:comment 'WaferStatus desrcibes Defects and preprocess status of a specific Wafer.' ;
    rdfs:range xsd:string . 



# example instance
    #:Wafer_42 a cmpo:Wafer ;
    #cmpo:hasWaferId "W-2026-X" ;
    #cmpo:hasStatus "Defective" . # Der schnelle Status

    # Ein historischer Zustand (Snapshot)
   # :State_After_Step1 a cmpo:WaferState ;
   # cmpo:isStateOf :Wafer_42 ; # Hier nutzt du deine Property
   # cmpo:hasThickness "650nm" ;
   # cmpo:hasTimestamp "2026-02-16T15:00:00Z" .
    

#################################################################
### Process Card & Data Sources
#################################################################

cmpo:ProcessCard rdfs:subClassOf iao:InformationContentEntity ; # maheshika would you fix this please? #for now the processcard is the main data source in future MES-Data has to be included.
    rdfs:comment "a document that is connected to a WaferLot, which contains information about all wafer in the lot including defects and notes as well as target values and planned processes (Services)." .

    cmpo:isSpecifiedBy a owl:ObjectProperty ; #connects wafer to process card
    rdfs:domain cmpo:Wafer ;
    rdfs:range cmpo:ProcessCard .


    cmpo:targetLayerThickness a owl:DatatypeProperty ; #idea: target values are connected to the process card and not directly to the wafer.
    rdfs:domain cmpo:ProcessCard ;
    rdfs:range xsd:float .

  #################################################################
### Agents and Experts
#################################################################
cmpo:Agent           rdfs:subClassOf BFO:0000030 ;
rdfs:label'Agent' . # yes. agent = object (has role)
cmpo:ProjectOwner a owl:Class ;
    rdfs:subClassOf BFO:0000023 ; # BFO: Role
    rdfs:label "Project Owner"@en , "Projektverantwortlicher"@de ;
    skos:altLabel "Lot Owner" ;
    skos:altLabel "Verantwortlich" ;
    rdfs:comment 'Project owner is the Person who is responsible for the wafer lot. The project owner acts like the costumer for the process (he/she defines target values)' . 
cmpo:ProcessOwner a owl:Class ;
rdfs:subClassOf BFO:0000023 ;
    rdfs:label "Process Owner"@en , "Prozessverantwortlicher"@de ;
    skos:altLabel "Tool Expert" ;
    skos:altLabel "Expert" ;
    skos:altLabel 'Operator' ;
    rdfs:comment 'Process owner is the person who is responsible for a specific process or tool' .
cmpo:hasRole a owl:ObjectProperty ;
    rdfs:domain BFO:0000030 ;
    rdfs:range BFO:0000023 .

cmpo:hasProjectOwnerRole rdfs:subPropertyOf cmpo:hasRole ;
    rdfs:label "has Project Owner Role"@en ;
    rdfs:range cmpo:ProjectOwner .

cmpo:hasProcessOwnerRole rdfs:subPropertyOf cmpo:hasRole ;
    rdfs:label "has Process Owner Role"@en ;
    rdfs:range cmpo:ProcessOwner .

    #################################################################
### Process & Steps
#################################################################

cmpo:Measurement a rdfs:Class .

    cmpo:hasMeasurement a owl:ObjectProperty ;
    rdfs:domain cmpo:WaferState ;
    rdfs:range cmpo:Measurement .

# measruement details
    cmpo:atTime a owl:DatatypeProperty ;
    rdfs:domain cmpo:Measurement ;
    rdfs:range xsd:dateTime .

    cmpo:measuredValue a owl:DatatypeProperty ;
    rdfs:domain cmpo:Measurement ;
    rdfs:range xsd:float .

    cmpo:fromStep a owl:ObjectProperty ;
    rdfs:domain cmpo:Measurement ;
    rdfs:range cmpo:Step .

    cmpo:usesTool a owl:ObjectProperty ;
    rdfs:domain cmpo:Measurement ;
    rdfs:range cmpo:Tool .

##cmpo:Metrology   rdfs:subClassOf cmpo:Measurement;
#rdfs:comment "all measurement data and methods" . 

cmpo:Service rdfs:subClassOf BFO:0000015;
rdfs:comment 'According to the process card service is the label for a genral step or a operator group in the whole (chip-)production process like CMP, PVD or ALD)' .

cmpo:Step  rdfs:subClassOf BFO:0000015  ;
rdfs:label "Step" ;
skos:altLabel 'Task' @en ;
rdfs:comment "One Action or Step in the whole Workflow of a Process. Example: measuring step on FTR or Polishing Process on CMP Tool".
   
    cmpo:atTime a owl:DatatypeProperty ; #Timestamp 
    rdfs:domain cmpo:Step ;
    rdfs:range xsd:dateTime .

    cmpo:hasInput a owl:ObjectProperty  ; #RO0002233
    rdfs:subPropertyOf RO:0002233 ;
    rdfs:domain cmpo:Step ;
    rdfs:range cmpo:WaferState;
    rdfs:label "has input" .

    cmpo:hasOutput a owl:ObjectProperty  ; #RO0002234
    rdfs:subPropertyOf RO:0002234 ;
    rdfs:domain cmpo:Step ;
    rdfs:range cmpo:WaferState;
    rdfs:label "has output" .   

#cmpo:Step rdfs:subClassOf BFO:0000015 , #Prüfen, ob sinnvoll
   # [ a owl:Restriction ;
   #  owl:onProperty cmpo:hasOutput ;
  #   owl:someValuesFrom cmpo:WaferState # Der Output muss existieren
  # ] ,
  #  [ a owl:Restriction ;
  #   owl:onProperty cmpo:hasMeasuredThickness ;
  #  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
  #    owl:onDataRange xsd:float # Es muss mindestens ein Messwert vorhanden sein
  # ] .

    #################################################################
### Tools and Consumables
#################################################################

cmpo:Equipment       rdfs:subClassOf BFO:0000030 . # BFO:object
cmpo:Tool            rdfs:subClassOf cmpo:Equipment ;
rdfs:comment 'tools are all kind of tools for processing and measuring wafer. Specific tools are instances.' .

    cmpo:executedOn a owl:ObjectProperty ;  
    rdfs:subPropertyOf RO:0000057 ;  # RO: has participant
    rdfs:domain cmpo:Step ;
    rdfs:range cmpo:Tool ;
    rdfs:label "executed on" ;
    rdfs:comment "Prcocess card or MES prvides information which tool is used for specific step as ArdenneCS400S -old Process card or 2THI_CMP_ME_Cu_6Z_ -MES" .

   cmpo:ToolID a owl:DatatypeProperty ;
    rdfs:domain cmpo:Step ;
    rdfs:domain cmpo:Tool ;
    rdfs:range xsd:string ;
    rdfs:label "hasToolID" ;
    rdfs:comment "Identifies the specific tool used in a CMP step (e.g., 'CMP_Tool_001'). Applies to both Step and Tool classes." .

cmpo:ToolComponent a owl:Class .
    
    cmpo:hasToolComponent a owl:ObjectProperty ;
    rdfs:domain cmpo:Tool ;
    rdfs:range cmpo:ToolComponent .

# cmpo:CMPTool         rdfs:subClassOf cmpo:Tool . #not needed, when all tools have components?
   # cmpo:hasToolComponent a owl:ObjectProperty ;
    #rdfs:domain cmpo:CMPTool ;
    #rdfs:range cmpo:ToolComponent .
cmpo:Consumable rdfs:subClassOf cmpo:ToolComponent;
rdfs:comment 'Consumables are ToolComponents that change over time and have a lifetime or specific service life.' .

    cmpo:hasLifetime a owl:DatatypeProperty ; #lifetime is not known
    rdfs:domain cmpo:Consumable ;
    rdfs:range xsd:string . 

    cmpo:UsageTracking a owl:Class ;
    rdfs:label "Usage Tracking"@en ;
    rdfs:comment "A generic class for tracking the usage metrics (e.g., runtime, count, wear) of consumables or tools."@en ;
    owl:hasKey (cmpo:hasUsageId) .


    cmpo:tracksComponent a owl:ObjectProperty ;
    rdfs:domain cmpo:UsageTracking ;
    rdfs:range cmpo:ToolComponent ; 
    rdfs:label "tracks component"@en ;
    rdfs:comment "Connects Tracking-Data with physical Tool Component." .
    
    cmpo:hasUsageType a owl:DatatypeProperty ; #alternative Usage Type as class
    rdfs:domain cmpo:UsageTracking ;
    rdfs:range xsd:string ;
    rdfs:label "Usage Type"@en ;
    rdfs:comment "Describes the type of usage (e.g., 'Polishing', 'Conditioning')."@en .

    cmpo:hasUsageId a owl:DatatypeProperty ;
    rdfs:domain cmpo:UsageTracking ;
    rdfs:range xsd:string ;
    rdfs:label "Usage ID"@en .

    cmpo:hasUsageTime a owl:DatatypeProperty ;
    rdfs:domain cmpo:UsageTracking ;
    rdfs:range xsd:float ;
    rdfs:label "Usage Time"@en .

    cmpo:hasUsageCount a owl:DatatypeProperty ;
    rdfs:domain cmpo:UsageTracking ;
    rdfs:range xsd:float ;
    rdfs:label "Usage Count"@en .

    # Example Instance
    #:Log_Dresser_001 a cmpo:UsageTracking ;
    #cmpo:hasUsageId "TRK-2024-001" ;
    #cmpo:tracksComponent :Conditioner_Arm_A ;
    #cmpo:hasUsageType "Conditioning" ;
    #cmpo:hasUsageTime "PT10H"^^xsd:float ; # 10 Stunden Laufzeit
    #cmpo:hasUsageCount 450 . # 450 Sweeps oder Wafer

cmpo:ConditionerPad   rdfs:subClassOf cmpo:Consumable .
cmpo:PolishingPad rdfs:subClassOf cmpo:Consumable .

#cmpo:Stage rdfs:subClassOf cmpo:ToolComponent ; #Klären, ob Mirra 4 Stages oder 4 Platen hat!
   # rdfs:label 'Table' @en ;    
   # skos:altLabel 'Platen' @en ;
   # rdfs:comment 'Stage refers to the large, rotating circular table (the Platen) where the polishing pad is mounted.' .

cmpo:Platen a owl:Class ; #ggfs. equivalent to Stage?
    rdfs:subClassOf cmpo:ToolComponent ;
    rdfs:label "Platen"@en ;
    skos:altLabel 'Polishing Stage'@en ;
    skos:altLabel 'Stage' @en ;
    skos:altLabel "Polishing Table"@en ;
    rdfs:comment "The large rotating disk where the polishing pad is mounted on."@en .



cmpo:hasPolishingPad a owl:ObjectProperty ;
    owl:inverseOf cmpo:isMountedOn ;
    rdfs:label "has polishing pad"@en ;
    rdfs:domain cmpo:Platen ;
    rdfs:range cmpo:PolishingPad .

cmpo:isMountedOn a owl:ObjectProperty ;
    rdfs:label "is mounted on"@en ;
    rdfs:domain cmpo:PolishingPad ;
    rdfs:range cmpo:Platen ;
    rdfs:comment "Relates a consumable polishing pad to the specific platen it is currently attached to."@en .

#cmpo:hasPadUsage a owl:DatatypeProperty ; #more specific cmpo:usageCount (Anzahl Wafer) oder cmpo:usageTime (Minuten).
   # rdfs:label  'Lifetime Polishing Pad' ;   #better Runtime?
   #  skos:altLabel "USAGE_OF_POLISHING_TABLE"@en ;
   #  skos:altLebel "Runtime Polishing Pad"@en ;
   # rdfs:domain cmpo:PolishingPad ;
   # rdfs:range xsd:decimal ;
 #   rdfs:comment "Specifies the accumulated usage (e.g., in minutes or number of wafers) for a specific polishing pad."@en .

    cmpo:hasRotationSpeed a owl:DatatypeProperty ; #alt - cmpo:velocityInRPM - relative Velocity in m/s would require a new DataProperty
    rdfs:domain cmpo:Platen ;
    rdfs:label 'Platen Rotation Speed' ;
    rdfs:comment 'Velocity of the Platen is measured in RPM (revolution per minute) in PHM Data it is Stage Rotation.' ;
    rdfs:range qudt:Quantity ;
    owl:propertyChainAxiom (cmpo:hasRotationSpeed qudt:hasUnit qudt:RPM) .

    cmpo:temperatureInC a owl:DatatypeProperty ; 
    rdfs:label 'Pad Temperature' ;
    rdfs:domain cmpo:PolishingPad ;
    rdfs:comment'the pad temerature is measured in degrees Celcius.';
    rdfs:range qudt:Quantity ;
    owl:propertyChainAxiom (cmpo:temperatureInC qudt:hasUnit qudt:DEG_C) . 




cmpo:Carrier a owl:Class ;
    rdfs:subClassOf cmpo:ToolComponent ;
    rdfs:label "Carrier"@en ;
    skos:altLabel 'Head' @en;
    skos:altLabel "Wafer Head"@en ;
    skos:altLabel "Polishing Head"@en .

    cmpo:hasComponent a owl:ObjectProperty; #needed?
    rdfs:label 'has Component' ;
    rdfs:domain cmpo:Carrier ;
    rdfs:range cmpo:ToolComponent .

    cmpo:HeadSpeedRPM a owl:DatatypeProperty ;
    rdfs:label 'Head Speed' ; 
    skos:altLabel 'Head Rotation' @en ;
    skos:altLabel 'Carrier RPM' @en ;
    rdfs:domain cmpo:Carrier ;
    rdfs:range xsd:float . #or integer

cmpo:RetainingRing   rdfs:subClassOf cmpo:Consumable ;
    rdfs:label 'Retaining Ring' @en ;
        skos:altLabel 'Retainer Ring' @en .
cmpo:Membrane rdfs:subClassOf cmpo:Consumable ;
    rdfs:label 'Membrane' .

cmpo:PressurizedSheet rdfs:subClassOf cmpo:Consumable ;
    rdfs:label 'Pressurized Sheet' .

cmpo:PressureZone a owl:Class ;
    rdfs:label 'Pressure Zone Carrier ' @en ;
    rdfs:comment 'A region in a carrier that can be independently pressurized. The number and configuration vary by tool.' .
cmpo:RetainingRingZone rdfs:subClassOf cmpo:PressureZone .
cmpo:MembraneZone rdfs:subClassOf cmpo:PressureZone .

cmpo:RippleAirBagZone rdfs:subClassOf cmpo:PressureZone .

cmpo:CenterAirBagZone rdfs:subClassOf cmpo:PressureZone . 

cmpo:MainOuterAirBagZone rdfs:subClassOf cmpo:PressureZone . 

cmpo:EdgeAirBagZone rdfs:subClassOf cmpo:PressureZone .


    cmpo:hasPressureZone a owl:ObjectProperty ;
      owl:equivalentProperty BFO:has_part ;
      rdfs:label 'has Pressure Zone ' @en;
    rdfs:domain cmpo:Carrier ;
    rdfs:range cmpo:PressureZone ;
    rdfs:comment 'A carrier may have multiple pressure zones. The number and configuration depend on the tool.' .


   
cmpo:Carrier a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty cmpo:hasPressureZone ;
        owl:minCardinality 1
    ] ;
    rdfs:comment "At least one pressure zone is required for functional operation." .

cmpo:hasSetPoint a owl:DatatypeProperty ;
    rdfs:label "has set-point" ;
    rdfs:comment "The target pressure value (set-point) for a zone." ;
    rdfs:domain cmpo:PressureZone ;
    rdfs:range xsd:float ;
    owl:inverseFunctionalProperty true .

cmpo:hasMeasuredValue a owl:DatatypeProperty ;
    rdfs:label "has measured value" ;
    rdfs:comment "The actual pressure value measured for a zone." ;
    rdfs:domain cmpo:PressureZone ;
    rdfs:range xsd:float ;
    owl:inverseFunctionalProperty true .


cmpo:hasPosition a owl:DatatypeProperty ;
    rdfs:domain cmpo:PressureZone ;
    rdfs:range xsd:integer .
cmpo:numberOfZones a owl:AnnotationProperty ; 
    rdfs:label "Number of Pressure Zones" ;
    rdfs:comment "An annotation to specify how many pressure zones a carrier type has." .
cmpo:Conditioner   rdfs:subClassOf cmpo:ToolComponent ;
    rdfs:label "Conditioner"@en  ;
     skos:altLabel "Dresser"@en ;
     skos:altLabel "Pad Conditioner"@en .
   
   
    cmpo:conditions a owl:ObjectProperty ;
    rdfs:label 'conditions' ;
    rdfs:comment 'conditioning happens while polishing step and is measured and set up in sweeps per minute.' ;
    rdfs:domain cmpo:Conditioner;
    rdfs:range cmpo:PolishingPad .

    cmpo:hasConditioningSweepRate a owl:DatatypeProperty ;
    rdfs:label "Conditioning Sweep Rate"@en ;
    rdfs:comment "The frequency of the conditioner arm movement across the pad, measured in sweeps per minute (SPM)."@en ;
    rdfs:domain cmpo:Conditioner ;
    rdfs:range xsd:integer .

#cmpo:ConditionerUsage a owl:DatatypeProperty ; #more specific cmpo:usageCount (Anzahl Wafer) oder cmpo:usageTime (Minuten).
   # rdfs:label 'Lifetime Condioner' ;   #better Runtime?
   #  skos:altLabel "USAGE_OF_DRESSER"@en ;
   #  skos:altLebel "Runtime Pad Conditioner"@en ;
   # rdfs:domain cmpo:ConditionerPad ;
  # # rdfs:range xsd:decimal ;
  #  rdfs:comment "Tracks the accumulated wear or usage time of conditioner pad."@en . 
cmpo:ConditionerTable rdfs:subClassOf cmpo:ToolComponent ;
    rdfs:label 'Conditioner Table'@en ;
     skos:altLabel "Dresser Table"@en ;
     rdfs:comment "conditioner table is the parking position for the conditioner and where it is cleaned" .



#cmpo:ConditionerTableUsage a owl:DatatypeProperty ;
 #   rdfs:label 'Lifetime Condioner Table' ;   #better Runtime?
  #   skos:altLabel "USAGE_OF_DRESSER_TABLE"@en ;
   #  skos:altLebel "Runtime Conditioner Table"@en ;
    #rdfs:domain cmpo:ConditionerTable ;
    #rdfs:range xsd:decimal ;
    #rdfs:comment "Tracks the accumulated usage time of conditioner table for cleaning the contioner."@en . 

    cmpo:conditionerWaterStatus a owl:DatatypeProperty ;
    rdfs:label 'Conditioner Water' ; 
     skos:altLabel "DRESSING_WATER_STATUS"@en ;
     skos:altLabel 'Conditioner Rinse Water' ;
    rdfs:domain cmpo:ConditionerTable ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Amount of deionized water  used for rinsing and cooling the dresser/conditioner."@en .

cmpo:Chamber   rdfs:subClassOf cmpo:ToolComponent . 
    cmpo:hasNumber a owl:ObjectProperty ;
    rdfs:domain cmpo:Chamber ;
    rdfs:comment 'defines the chamber in a specific tool, where the wafer is processed. NOT Pressure Chambers in the Carrier' ;
    rdfs:range xsd:integer .

cmpo:Slurry rdfs:subClassOf cmpo:Consumable ; 
    rdfs:label 'Slurry'@en .

cmpo:DiWater rdfs:subClassOf cmpo:Consumable ;
    rdfs:label 'DI-Water' @en ;
    rdfs:comment 'DI Water is deionized water used for rinsing and cleaning' .


cmpo:DiWater rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cmpo:isDeliveredBy ;
    owl:someValuesFrom cmpo:SlurryPipe
] .

cmpo:Slurry rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cmpo:isDeliveredBy ;
    owl:someValuesFrom cmpo:SlurryPipe
] .

    cmpo:slurryName a owl:DatatypeProperty ;
    rdfs:label "Slurry Name"@en ;
    rdfs:domain cmpo:Slurry ;
    rdfs:range xsd:string ;
    rdfs:comment "Name of the Slurry like KLEBOSOL" .

    cmpo:slurryBatch a owl:DatatypeProperty ;
    rdfs:label 'Slurry Charge' ;
    rdfs:domain cmpo:Slurry ;
    rdfs:range xsd:string .

    cmpo:usedSlurry a owl:ObjectProperty ;
    rdfs:domain cmpo:WaferState ; # Oder Step
    rdfs:range cmpo:Slurry .
cmpo:SlurryPipe   rdfs:subClassOf cmpo:ToolComponent ;
    rdfs:label 'Slurry Pipe' @en;
    skos:altLabel 'Slurry Line' @en;
    skos:altLabel 'Slurry Delivery Pipe' @en ;
    rdfs:comment 'Slurry Pipes are used for Slurry and DI Water for rinsing and cleaning depending on the step' .

    cmpo:isDeliveredBy a owl:ObjectProperty ;
    rdfs:label "delivered by"@en ;
    rdfs:comment 'a general object property, which connects a specific Slurry pipe with a slurry or the DI water via an instance.' .
cmpo:SlurryFlowRate a owl:Class ;
    rdfs:subClassOf cmpo:Parameter .

cmpo:hasSlurryFlowRate a owl:ObjectProperty ;
    rdfs:domain cmpo:SlurryPipe ;
    rdfs:range cmpo:SlurryFlowRate ;
    rdfs:comment 'Links a SlurryPipe to its SlurryFlowRate parameter.' .

    cmpo:SlurryFlowRate a owl:DatatypeProperty ;
    rdfs:label 'Slurry Flow' @en;
    rdfs:domain cmpo:SlurryPipe ;
    rdfs:range xsd:float ;
    rdfs:comment 'Slurry flow rate for a specific Slurry pipe. In the PHM data set this is Slurry_Flow_Line_A.' .



    #################################################################


## Recipe and Parameter
#################################################################


cmpo:Recipe a rdfs:Class;
rdfs:comment "recipe is collection of componants with specific (imput) parameters like Preassure values or conditioning pad with sweeps per minute)" .

    cmpo:usesRecipe a owl:ObjectProperty ; 
    rdfs:domain cmpo:Step ; 
    rdfs:range cmpo:Recipe .

    cmpo:hasInstruction a owl:ObjectProperty ;
    rdfs:domain cmpo:Recipe ;
    rdfs:range cmpo:ProcessParameter .
    

cmpo:Parameter a owl:Class ;
    rdfs:label "Parameter"@en .

    cmpo:hasUnit a owl:ObjectProperty ;
     rdfs:label "Unit"@en ;
    rdfs:comment "The unit of measurement for a parameter."@en ;
     rdfs:domain cmpo:Parameter ;
      rdfs:range qudt:Unit . 

    cmpo:hasValue a owl:DatatypeProperty ;
    rdfs:domain cmpo:Parameter ;
    rdfs:range xsd:float .

# --- Längenmaße (Metrology & Removal) ---

cmpo:Angstrom a cmpo:Unit ;
    owl:sameAs unit:ANGSTROM ;
    qudt:hasSymbol "Å" ;
    rdfs:label "Angström"@de .

cmpo:Nanometer a cmpo:Unit ;
    owl:sameAs unit:NanoM ;
    qudt:hasSymbol "nm" ;
    rdfs:label "Nanometer"@de .

cmpo:Micrometer a cmpo:Unit ;
    owl:sameAs unit:MicroM ;
    qudt:hasSymbol "µm" ;
    rdfs:label "Mikrometer"@de .

### --- Druck & Kraft (Downforce / Backpressure) ---

cmpo:PSI a cmpo:Unit ;
    owl:sameAs unit:PSI ;
    qudt:hasSymbol "psi" ;
    rdfs:label "Pounds per Square Inch"@en .

cmpo:Bar a cmpo:Unit ;
    owl:sameAs unit:BAR ;
    qudt:hasSymbol "bar" ;
    rdfs:label "Bar"@de .

cmpo:Newton a cmpo:Unit ;
    owl:sameAs unit:N ;
    qudt:hasSymbol "N" ;
    rdfs:label "Newton"@de .

### --- Zeit & Geschwindigkeit (Platen / Carrier) ---

cmpo:Second a cmpo:Unit ;
    owl:sameAs unit:SEC ;
    qudt:hasSymbol "s" ;
    rdfs:label "Sekunde"@de .

cmpo:Minute a cmpo:Unit ;
    owl:sameAs unit:MIN ;
    qudt:hasSymbol "min" ;
    rdfs:label "Minute"@de .

cmpo:RPM a cmpo:Unit ;
    owl:sameAs unit:V_REV-PER-MIN ;
    qudt:hasSymbol "rpm" ;
    rdfs:label "Umdrehungen pro Minute"@de .

### --- Flussrate & Konzentration (Slurry) ---

cmpo:MilliliterPerMinute a cmpo:Unit ;
    owl:sameAs unit:MilliL-PER-MIN ;
    qudt:hasSymbol "ml/min" ;
    rdfs:label "Milliliter pro Minute"@de .

cmpo:Percent a cmpo:Unit ;
    owl:sameAs unit:PERCENT ;
    qudt:hasSymbol "%" ;
    rdfs:label "Prozent"@de .

### --- Temperatur ---
cmpo:DegreeCelsius a cmpo:Unit ;
    owl:sameAs unit:DEG_C ;
    qudt:hasSymbol "°C" ;
    rdfs:label "Grad Celsius"@de .

cmpo:Kelvin a cmpo:Unit ;
    owl:sameAs unit:K ;
    qudt:hasSymbol "K" ;
    rdfs:label "Kelvin"@de .

cmpo:DegreeFahrenheit a cmpo:Unit ;
    owl:sameAs unit:DEG_F ;
    qudt:hasSymbol "°F" ;
    rdfs:label "Grad Fahrenheit"@de .

cmpo:NanometersPerMinute a cmpo:Unit ;
    owl:sameAs unit:NANOMETER_PER_MINUTE ;
    qudt:hasSymbol "nm/min" ;
    rdfs:label "Nanometers per minute" .

    cmpo:hasMaterialRemovalRate a owl:DatatypeProperty ;
    rdfs:domain cmpo:Step ;
    rdfs:range xsd:float ;
    rdfs:comment "Rate of material removal during a CMP process, measured in nanometers per minute (nm/min)" .

# 1. Set point parameter (Soll-Werte / Recipe)
cmpo:ProcessParameter rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Process Parameter (Set-Point)"@en ;
    rdfs:comment "Values specified by the engineer in the recipe (e.g., pressure, speed)." .

# 2. measurement parameters (Ist-Werte / In-situ Data)
cmpo:MonitoringParameter rdfs:subClassOf cmpo:Parameter ;
    rdfs:label "Monitoring Parameter (Measured)"@en ;
    rdfs:comment "Sensor values measured during the process (e.g., motor current, vibration)." .

# 3. Disturbance parameter (Einflussfaktoren von außen)
cmpo:DisturbanceParameter rdfs:subClassOf cmpo:Parameter ; 
    rdfs:label "Disturbance Parameter"@en ;
    rdfs:comment "Influences that are not directly controlled (e.g., ambient temperature, age of the pad)."@de .

cmpo:DerivedParameter rdfs:subClassOf cmpo:MonitoringParameter ;
    rdfs:label 'derived Parameter' ;
    rdfs:comment 'Explicitly marks parameters derived from other parameters like MRR.' .

cmpo:MaterialRemovalRate rdfs:subClassOf cmpo:DerivedParameter ; 
    rdfs:label "Removal Rate" ;
    rdfs:comment "Derived parameter representing material removal rate during CMP." .

   cmpo:derivedFrom a owl:ObjectProperty ; # do we need Source Parameter as a Class?
    rdfs:label "derived from" ;
    rdfs:comment "Links a derived parameter to its source parameters (monitoring or process)." ;
    rdfs:domain cmpo:DerivedParameter ;  
    rdfs:range cmpo:Parameter .  

    cmpo:derivationFormula a owl:DatatypeProperty ;
    rdfs:domain cmpo:DerivedParameter ;
    rdfs:range xsd:string ;
    rdfs:label "derivation formula" ;
    rdfs:comment "Describes the formula used to compute a derived parameter." .


# Specific parameter: Pressure 
cmpo:PressureParameter a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cmpo:hasUnit ;
    owl:hasValue cmpo:Bar
  ] .

cmpo:PressureSetPoint rdfs:subClassOf cmpo:ProcessParameter ;
  rdfs:label "Pressure Set-Point"@en ;
  rdfs:comment "Target pressure value in the recipe." .

cmpo:PressureMeasurement rdfs:subClassOf cmpo:MonitoringParameter ;
  rdfs:label "Pressure Measurement"@en ;
  rdfs:comment "Actual pressure value measured during the process." .
