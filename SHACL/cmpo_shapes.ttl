@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix cmpo:  <https://tucid/cpmo/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
### Wafer Shape
### Every Wafer must have an ID, belong to a Lot,
### and have at least one material.
#################################################################

cmpo:WaferShape
    a sh:NodeShape ;
    sh:targetClass cmpo:Wafer ;
    rdfs:comment "Validates that each Wafer instance has required properties." ;

    sh:property [
        sh:path cmpo:hasID ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A Wafer must have at least one hasID value of type xsd:string." ;
    ] ;

    sh:property [
        sh:path cmpo:hasLot ;
        sh:minCount 1 ;
        sh:class cmpo:Lot ;
        sh:message "A Wafer must be linked to at least one Lot via cmpo:hasLot." ;
    ] ;

    sh:property [
        sh:path cmpo:hasMaterial ;
        sh:minCount 1 ;
        sh:message "A Wafer must declare at least one material via cmpo:hasMaterial." ;
    ] .


#################################################################
### CMPTool Shape
### A CMPTool must have a machine ID and at least one component.
#################################################################

cmpo:CMPToolShape
    a sh:NodeShape ;
    sh:targetClass cmpo:CMPTool ;
    rdfs:comment "Validates that each CMPTool has an identifier and at least one component." ;

    sh:property [
        sh:path cmpo:machineID ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A CMPTool must have a machineID." ;
    ] ;

    sh:property [
        sh:path cmpo:hasCMPToolComponent ;
        sh:minCount 1 ;
        sh:class cmpo:CMPToolComponent ;
        sh:message "A CMPTool must have at least one CMPToolComponent." ;
    ] .


#################################################################
### Recipe Shape
### A Recipe must reference at least one Parameter.
#################################################################

cmpo:RecipeShape
    a sh:NodeShape ;
    sh:targetClass cmpo:Recipe ;
    rdfs:comment "Validates that each Recipe references at least one process parameter." ;

    sh:property [
        sh:path cmpo:usesParameter ;
        sh:minCount 1 ;
        sh:class cmpo:Parameter ;
        sh:message "A Recipe must use at least one Parameter." ;
    ] .


#################################################################
### Slurry Shape
### Slurry must declare its type and charge number.
#################################################################

cmpo:SlurryShape
    a sh:NodeShape ;
    sh:targetClass cmpo:Slurry ;
    rdfs:comment "Validates Slurry instances have type and charge information." ;

    sh:property [
        sh:path cmpo:hasSlurryType ;
        sh:minCount 1 ;
        sh:class cmpo:SlurryType ;
        sh:message "A Slurry must have a SlurryType." ;
    ] ;

    sh:property [
        sh:path cmpo:hasChargeNo ;
        sh:minCount 1 ;
        sh:message "A Slurry must have a charge number." ;
    ] .


#################################################################
### PolishingPad Shape
### A PolishingPad must have a lifetime value.
#################################################################

cmpo:PolishingPadShape
    a sh:NodeShape ;
    sh:targetClass cmpo:PolishingPad ;
    rdfs:comment "Validates PolishingPad instances declare their lifetime." ;

    sh:property [
        sh:path cmpo:hasPadLifetime ;
        sh:minCount 1 ;
        sh:message "A PolishingPad must have a lifetime value." ;
    ] .


#################################################################
### Pressure Parameter Shape
### Pressure values must be non-negative floats.
#################################################################

cmpo:PressureShape
    a sh:NodeShape ;
    sh:targetClass cmpo:Pressure ;
    rdfs:comment "Validates that Pressure parameter values are non-negative." ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:float ;
        sh:minInclusive 0.0 ;
        sh:message "Pressure value must be a non-negative float (unit: psi)." ;
    ] .


#################################################################
### PlatenSpeed Shape
### PlatenSpeed must be a positive float.
#################################################################

cmpo:PlatenSpeedShape
    a sh:NodeShape ;
    sh:targetClass cmpo:PlatenSpeed ;
    rdfs:comment "Validates PlatenSpeed values are within a reasonable operating range." ;

    sh:property [
        sh:path rdf:value ;
        sh:datatype xsd:float ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 200.0 ;
        sh:message "PlatenSpeed must be a float between 0 and 200 (rpm)." ;
    ] .


#################################################################
### CMPProcess Step Shape
### A CMPProcess must have at least one Step.
#################################################################

cmpo:CMPProcessShape
    a sh:NodeShape ;
    sh:targetClass cmpo:CMPProcess ;
    rdfs:comment "Validates that each CMPProcess has at least one linked Step." ;

    sh:property [
        sh:path cmpo:hasStep ;
        sh:minCount 1 ;
        sh:class cmpo:Step ;
        sh:message "A CMPProcess must have at least one Step." ;
    ] .


#################################################################
### Lot Shape
### A Lot must have at least one Wafer.
#################################################################

cmpo:LotShape
    a sh:NodeShape ;
    sh:targetClass cmpo:Lot ;
    rdfs:comment "Validates that a Lot contains at least one Wafer." ;

    sh:property [
        sh:path [ sh:inversePath cmpo:hasLot ] ;
        sh:minCount 1 ;
        sh:message "A Lot must be referenced by at least one Wafer." ;
    ] .
