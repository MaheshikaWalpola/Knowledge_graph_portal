@prefix coc:  <http://example.org/certificate#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Schema for sample4_certificate_of_conformance.pdf (supplier certificate of conformance)

coc: a owl:Ontology ;
    rdfs:label "Certificate of conformance schema" .

# ---------------- Classes ----------------
coc:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "A company: the supplier issuing the certificate or the customer receiving it." .

coc:Certificate a owl:Class ;
    rdfs:label "Certificate of conformance" ;
    rdfs:comment "The certificate document: references, dates, specification and signatory." .

coc:WaferLot a owl:Class ;
    rdfs:label "Wafer lot" ;
    rdfs:comment "The delivered lot of wafers and its material properties." .

coc:InspectionResult a owl:Class ;
    rdfs:label "Inspection result" ;
    rdfs:comment "One acceptance result: property, specification, measured min/max and pass/fail status." .

# ---------------- Organization ----------------
coc:organizationName a owl:DatatypeProperty ;
    rdfs:domain coc:Organization ; rdfs:range xsd:string .

coc:streetAddress a owl:DatatypeProperty ;
    rdfs:domain coc:Organization ; rdfs:range xsd:string .

coc:postalCodeAndCity a owl:DatatypeProperty ;
    rdfs:domain coc:Organization ; rdfs:range xsd:string .

coc:country a owl:DatatypeProperty ;
    rdfs:domain coc:Organization ; rdfs:range xsd:string .

coc:phone a owl:DatatypeProperty ;
    rdfs:domain coc:Organization ; rdfs:range xsd:string ;
    skos:altLabel "Tel." .

coc:department a owl:DatatypeProperty ;
    rdfs:domain coc:Organization ; rdfs:range xsd:string .

# ---------------- Certificate ----------------
coc:certificateNumber a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:string ;
    skos:altLabel "Our ref." .

coc:issueDate a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:date ;
    skos:altLabel "Date" .

coc:purchaseOrderNumber a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:string ;
    skos:altLabel "Your PO" .

coc:deliveryNoteNumber a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:string ;
    skos:altLabel "delivery note" .

coc:shipDate a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:date .

coc:specification a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:string ;
    skos:altLabel "specification" .

coc:specificationRevision a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:string .

coc:signatoryName a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:string .

coc:signatoryRole a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:string .

# Test note (not shown to the AI): In the sample PDF this only appears inside the stamp image.
coc:qaApprovalDate a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:date ;
    rdfs:comment "Date of the QA approval stamp." .

coc:recordRetentionYears a owl:DatatypeProperty ;
    rdfs:domain coc:Certificate ; rdfs:range xsd:integer .

coc:issuedBy a owl:ObjectProperty ;
    rdfs:domain coc:Certificate ; rdfs:range coc:Organization .

coc:issuedTo a owl:ObjectProperty ;
    rdfs:domain coc:Certificate ; rdfs:range coc:Organization .

coc:certifiesLot a owl:ObjectProperty ;
    rdfs:domain coc:Certificate ; rdfs:range coc:WaferLot .

# ---------------- WaferLot ----------------
coc:lotNumber a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:string ;
    skos:altLabel "lot number" .

coc:ingotId a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:string ;
    skos:altLabel "ingot" .

coc:waferCount a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:integer .

coc:cassetteCount a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:integer .

coc:grade a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:string ;
    rdfs:comment "Wafer grade, e.g. prime." .

coc:diameter a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:decimal ;
    rdfs:comment "Diameter in mm." ;
    skos:altLabel "diameter" .

coc:nominalThickness a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:decimal ;
    rdfs:comment "Nominal thickness in µm." ;
    skos:altLabel "nominal thickness" .

coc:dopant a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:string .

coc:conductivityType a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:string ;
    rdfs:comment "p-type or n-type." .

coc:crystalOrientation a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:string ;
    skos:altLabel "orientation" .

coc:growthMethod a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:string .

coc:resistivityMin a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:decimal ;
    rdfs:comment "Lowest measured resistivity in Ohm·cm." .

coc:resistivityMax a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:decimal ;
    rdfs:comment "Highest measured resistivity in Ohm·cm." .

coc:oxygenContent a owl:DatatypeProperty ;
    rdfs:domain coc:WaferLot ; rdfs:range xsd:decimal ;
    rdfs:comment "Average oxygen content in ppma." ;
    skos:altLabel "Oxygen content" .

# ---------------- InspectionResult ----------------
coc:inspectedProperty a owl:DatatypeProperty ;
    rdfs:domain coc:InspectionResult ; rdfs:range xsd:string ;
    skos:altLabel "Property" .

coc:specifiedValue a owl:DatatypeProperty ;
    rdfs:domain coc:InspectionResult ; rdfs:range xsd:string ;
    rdfs:comment "Specification as written, e.g. <= 5 µm." ;
    skos:altLabel "Specification" .

coc:resultMin a owl:DatatypeProperty ;
    rdfs:domain coc:InspectionResult ; rdfs:range xsd:decimal .

coc:resultMax a owl:DatatypeProperty ;
    rdfs:domain coc:InspectionResult ; rdfs:range xsd:decimal .

coc:resultUnit a owl:DatatypeProperty ;
    rdfs:domain coc:InspectionResult ; rdfs:range xsd:string .

coc:status a owl:DatatypeProperty ;
    rdfs:domain coc:InspectionResult ; rdfs:range xsd:string ;
    skos:altLabel "Status" .

coc:resultForLot a owl:ObjectProperty ;
    rdfs:domain coc:InspectionResult ; rdfs:range coc:WaferLot .

# ---------------- Keys (owl:hasKey) ----------------
# What identifies a thing across documents. Classes without a key (rows, results,
# measurements) always stay separate instances.
coc:Organization owl:hasKey ( coc:organizationName ) .
coc:Certificate owl:hasKey ( coc:certificateNumber ) .
coc:WaferLot owl:hasKey ( coc:lotNumber ) .
