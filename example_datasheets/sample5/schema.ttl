@prefix pt:   <http://example.org/process-traveler#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Schema for sample5_process_traveler_de.pdf (bilingual German/English process traveler)

pt: a owl:Ontology ;
    rdfs:label "Process traveler schema" .

# ---------------- Classes ----------------
# Test note (not shown to the AI): In the sample PDF its name only appears inside the logo image.
pt:Company a owl:Class ;
    rdfs:label "Company" ;
    rdfs:comment "The manufacturer running the process." .

pt:ProductionOrder a owl:Class ;
    rdfs:label "Production order"@en , "Fertigungsauftrag"@de ;
    rdfs:comment "The order the traveler belongs to, with its release status." .

pt:MaterialBatch a owl:Class ;
    rdfs:label "Material batch"@en , "Materialcharge"@de ;
    rdfs:comment "The substrate material used for the order." .

pt:ProcessStep a owl:Class ;
    rdfs:label "Process step"@en , "Prozessschritt"@de ;
    rdfs:comment "One numbered process step executed on a tool and signed off." .

pt:ProcessParameter a owl:Class ;
    rdfs:label "Process parameter"@en , "Prozessparameter"@de ;
    rdfs:comment "One parameter of a process step with target and actual value and OK check." .

pt:Deviation a owl:Class ;
    rdfs:label "Deviation"@en , "Abweichung"@de ;
    rdfs:comment "A deviation or remark recorded on the traveler, possibly with a special release." .

pt:Form a owl:Class ;
    rdfs:label "Form" ;
    rdfs:comment "The form template the traveler is printed on." .

# ---------------- Company ----------------
pt:companyName a owl:DatatypeProperty ;
    rdfs:domain pt:Company ; rdfs:range xsd:string .

# ---------------- ProductionOrder ----------------
pt:orderNumber a owl:DatatypeProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range xsd:string ;
    skos:altLabel "Auftrags-Nr." , "Order No." .

pt:customer a owl:DatatypeProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range xsd:string ;
    skos:altLabel "Kunde" , "Customer" .

pt:item a owl:DatatypeProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range xsd:string ;
    skos:altLabel "Artikel" , "Item" .

pt:orderQuantity a owl:DatatypeProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range xsd:integer ;
    rdfs:comment "Ordered quantity in wafers." ;
    skos:altLabel "Menge" , "Qty" .

pt:remainingQuantity a owl:DatatypeProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range xsd:integer ;
    rdfs:comment "Quantity left after rejects." ;
    skos:altLabel "Restmenge" .

pt:dueDate a owl:DatatypeProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range xsd:date ;
    skos:altLabel "Liefertermin" , "Due" .

pt:orderStatus a owl:DatatypeProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range xsd:string ;
    skos:altLabel "Status" .

pt:productionReleaseDate a owl:DatatypeProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range xsd:date ;
    skos:altLabel "Freigabe Fertigung" , "Production release" .

pt:productionReleasedBy a owl:DatatypeProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range xsd:string .

pt:qaReleaseDate a owl:DatatypeProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range xsd:date ;
    skos:altLabel "Freigabe QS" , "QA release" .

pt:usesMaterial a owl:ObjectProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range pt:MaterialBatch .

pt:producedBy a owl:ObjectProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range pt:Company .

pt:documentedOn a owl:ObjectProperty ;
    rdfs:domain pt:ProductionOrder ; rdfs:range pt:Form .

# ---------------- MaterialBatch ----------------
pt:batchNumber a owl:DatatypeProperty ;
    rdfs:domain pt:MaterialBatch ; rdfs:range xsd:string ;
    skos:altLabel "Charge" , "Batch" .

pt:substrate a owl:DatatypeProperty ;
    rdfs:domain pt:MaterialBatch ; rdfs:range xsd:string ;
    rdfs:comment "Substrate description, e.g. material, diameter and orientation." ;
    skos:altLabel "Substrat" , "Substrate" .

pt:thickness a owl:DatatypeProperty ;
    rdfs:domain pt:MaterialBatch ; rdfs:range xsd:decimal ;
    rdfs:comment "Thickness in µm." ;
    skos:altLabel "Dicke" , "Thickness" .

pt:resistivityRange a owl:DatatypeProperty ;
    rdfs:domain pt:MaterialBatch ; rdfs:range xsd:string ;
    rdfs:comment "Resistivity range as written, in Ohm·cm." ;
    skos:altLabel "Widerstand" , "Resistivity" .

pt:receivedDate a owl:DatatypeProperty ;
    rdfs:domain pt:MaterialBatch ; rdfs:range xsd:date ;
    skos:altLabel "Eingang" , "Received" .

# ---------------- ProcessStep ----------------
pt:stepNumber a owl:DatatypeProperty ;
    rdfs:domain pt:ProcessStep ; rdfs:range xsd:integer ;
    skos:altLabel "Schritt" , "Step" .

pt:processName a owl:DatatypeProperty ;
    rdfs:domain pt:ProcessStep ; rdfs:range xsd:string ;
    skos:altLabel "Prozess" , "Process" .

pt:toolId a owl:DatatypeProperty ;
    rdfs:domain pt:ProcessStep ; rdfs:range xsd:string ;
    skos:altLabel "Anlage" , "Tool" .

pt:signOffDate a owl:DatatypeProperty ;
    rdfs:domain pt:ProcessStep ; rdfs:range xsd:date ;
    skos:altLabel "Datum" , "Date" .

pt:operatorInitials a owl:DatatypeProperty ;
    rdfs:domain pt:ProcessStep ; rdfs:range xsd:string ;
    skos:altLabel "Visum" , "Init." .

pt:stepOfOrder a owl:ObjectProperty ;
    rdfs:domain pt:ProcessStep ; rdfs:range pt:ProductionOrder .

# ---------------- ProcessParameter ----------------
pt:parameterName a owl:DatatypeProperty ;
    rdfs:domain pt:ProcessParameter ; rdfs:range xsd:string ;
    skos:altLabel "Parameter" .

pt:targetValue a owl:DatatypeProperty ;
    rdfs:domain pt:ProcessParameter ; rdfs:range xsd:string ;
    rdfs:comment "Target value as written, including unit and tolerance." ;
    skos:altLabel "Soll" , "Target" .

pt:actualValue a owl:DatatypeProperty ;
    rdfs:domain pt:ProcessParameter ; rdfs:range xsd:decimal ;
    rdfs:comment "Measured actual value as a number (unit in actualUnit)." ;
    skos:altLabel "Ist" , "Actual" .

pt:actualUnit a owl:DatatypeProperty ;
    rdfs:domain pt:ProcessParameter ; rdfs:range xsd:string .

# Test note (not shown to the AI): In the sample PDF these are drawn checkboxes, not text.
pt:withinSpec a owl:DatatypeProperty ;
    rdfs:domain pt:ProcessParameter ; rdfs:range xsd:boolean ;
    rdfs:comment "OK checkbox (i.O. = in Ordnung)." ;
    skos:altLabel "i.O." , "OK" .

pt:parameterOfStep a owl:ObjectProperty ;
    rdfs:domain pt:ProcessParameter ; rdfs:range pt:ProcessStep .

# ---------------- Deviation ----------------
pt:deviationDescription a owl:DatatypeProperty ;
    rdfs:domain pt:Deviation ; rdfs:range xsd:string ;
    skos:altLabel "Bemerkungen" , "Remarks" .

pt:specialReleaseNumber a owl:DatatypeProperty ;
    rdfs:domain pt:Deviation ; rdfs:range xsd:string ;
    skos:altLabel "Sonderfreigabe" .

pt:approvedBy a owl:DatatypeProperty ;
    rdfs:domain pt:Deviation ; rdfs:range xsd:string .

pt:approvalDate a owl:DatatypeProperty ;
    rdfs:domain pt:Deviation ; rdfs:range xsd:date .

pt:affectsStep a owl:ObjectProperty ;
    rdfs:domain pt:Deviation ; rdfs:range pt:ProcessStep .

# ---------------- Form ----------------
pt:formNumber a owl:DatatypeProperty ;
    rdfs:domain pt:Form ; rdfs:range xsd:string ;
    skos:altLabel "Formular" .

pt:formVersion a owl:DatatypeProperty ;
    rdfs:domain pt:Form ; rdfs:range xsd:string ;
    skos:altLabel "Version" .

pt:validFrom a owl:DatatypeProperty ;
    rdfs:domain pt:Form ; rdfs:range xsd:date ;
    skos:altLabel "gültig ab" .

# ---------------- Keys (owl:hasKey) ----------------
# What identifies a thing across documents. Classes without a key (rows, results,
# measurements) always stay separate instances.
pt:Company owl:hasKey ( pt:companyName ) .
pt:ProductionOrder owl:hasKey ( pt:orderNumber ) .
pt:MaterialBatch owl:hasKey ( pt:batchNumber ) .
pt:Form owl:hasKey ( pt:formNumber ) .
