@prefix ds:   <http://example.org/datasheet#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Schema for sample1_datasheet_ids*.pdf (internal measurement data sheet with ID fields)

ds: a owl:Ontology ;
    rdfs:label "Internal measurement data sheet schema (ID variant)" .

# ---------------- Classes ----------------
ds:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "The company that issued the data sheet." .

ds:DataSheet a owl:Class ;
    rdfs:label "Data sheet" ;
    rdfs:comment "The data sheet document and its metadata (document number, revision, author, approval)." .

ds:MeasurementRun a owl:Class ;
    rdfs:label "Measurement run" ;
    rdfs:comment "One measurement run identified by an ID, executed with a recipe between a start and end time." .

ds:Identification a owl:Class ;
    rdfs:label "Identification" ;
    rdfs:comment "The Identification block of the data sheet: the wafer and its ID2." .

ds:DeviceData a owl:Class ;
    rdfs:label "Device data" ;
    rdfs:comment "The Device Data block of the data sheet: electrical and thermal values, yield and package." .

ds:Device a owl:Class ;
    rdfs:label "Device" ;
    rdfs:comment "The semiconductor device that was measured." .

ds:Wafer a owl:Class ;
    rdfs:label "Wafer" ;
    rdfs:comment "The wafer the device was taken from, identified by its wafer ID." .

# ---------------- Organization ----------------
ds:organizationName a owl:DatatypeProperty ;
    rdfs:domain ds:Organization ; rdfs:range xsd:string ;
    rdfs:label "organization name" .

# ---------------- DataSheet ----------------
ds:documentNumber a owl:DatatypeProperty ;
    rdfs:domain ds:DataSheet ; rdfs:range xsd:string ;
    skos:altLabel "Doc No." .

ds:revision a owl:DatatypeProperty ;
    rdfs:domain ds:DataSheet ; rdfs:range xsd:string ;
    skos:altLabel "Rev." .

ds:author a owl:DatatypeProperty ;
    rdfs:domain ds:DataSheet ; rdfs:range xsd:string ;
    skos:altLabel "Author" .

ds:approvedBy a owl:DatatypeProperty ;
    rdfs:domain ds:DataSheet ; rdfs:range xsd:string ;
    skos:altLabel "Approved" .

ds:createdDate a owl:DatatypeProperty ;
    rdfs:domain ds:DataSheet ; rdfs:range xsd:date ;
    skos:altLabel "Created" .

ds:issuedBy a owl:ObjectProperty ;
    rdfs:domain ds:DataSheet ; rdfs:range ds:Organization .

ds:describesRun a owl:ObjectProperty ;
    rdfs:domain ds:DataSheet ; rdfs:range ds:MeasurementRun .

# ---------------- MeasurementRun ----------------
ds:runId a owl:DatatypeProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range xsd:string ;
    skos:altLabel "ID" .

ds:recipe a owl:DatatypeProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range xsd:string ;
    skos:altLabel "Recipe" .

ds:startTime a owl:DatatypeProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range xsd:dateTime ;
    skos:altLabel "Start" .

ds:endTime a owl:DatatypeProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range xsd:dateTime ;
    skos:altLabel "End" .

ds:runTitle a owl:DatatypeProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range xsd:string ;
    skos:altLabel "Title" .

ds:sampleName a owl:DatatypeProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range xsd:string ;
    rdfs:comment "The sample measured in this run." ;
    skos:altLabel "Sample" .

ds:filmThickness a owl:DatatypeProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range xsd:decimal ;
    rdfs:comment "Film thickness in nm." ;
    skos:altLabel "Film Thickness" .

ds:substrate a owl:DatatypeProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range xsd:string ;
    rdfs:comment "Substrate material, orientation and doping, e.g. Si <100>, p-type." ;
    skos:altLabel "Substrate" .

ds:id1 a owl:DatatypeProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range xsd:string ;
    skos:altLabel "ID1" .

# Test note (not shown to the AI): In the sample PDF this only appears inside the image.
ds:testTemperature a owl:DatatypeProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range xsd:decimal ;
    rdfs:comment "Test temperature in °C." ;
    skos:altLabel "Temperature" .

ds:measuredWafer a owl:ObjectProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range ds:Wafer ;
    rdfs:comment "The wafer measured in this run (the Wafer ID next to the run title)." ;
    skos:altLabel "Wafer ID" .

ds:measuredDevice a owl:ObjectProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range ds:Device .

ds:hasIdentification a owl:ObjectProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range ds:Identification .

ds:hasDeviceData a owl:ObjectProperty ;
    rdfs:domain ds:MeasurementRun ; rdfs:range ds:DeviceData .

# ---------------- Shared ----------------
ds:id2 a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "ID2. Appears both in the Identification block and next to the run title; no domain, so it can be used on any class." ;
    skos:altLabel "ID2" .

# ---------------- Identification ----------------
ds:identifiedWafer a owl:ObjectProperty ;
    rdfs:domain ds:Identification ; rdfs:range ds:Wafer ;
    rdfs:comment "The wafer listed in the Wafer ID column of the Identification block." ;
    skos:altLabel "Wafer ID" .

# ---------------- DeviceData ----------------
ds:supplyVoltage a owl:DatatypeProperty ;
    rdfs:domain ds:DeviceData ; rdfs:range xsd:decimal ;
    rdfs:comment "Supply voltage in V." ;
    skos:altLabel "Supply Voltage" .

ds:maxJunctionTemperature a owl:DatatypeProperty ;
    rdfs:domain ds:DeviceData ; rdfs:range xsd:decimal ;
    rdfs:comment "Maximum junction temperature in °C." ;
    skos:altLabel "Max. Junction Temp." .

ds:yield a owl:DatatypeProperty ;
    rdfs:domain ds:DeviceData ; rdfs:range xsd:decimal ;
    rdfs:comment "Yield as a fraction between 0 and 1." ;
    skos:altLabel "Yield" .

ds:package a owl:DatatypeProperty ;
    rdfs:domain ds:DeviceData ; rdfs:range xsd:string ;
    rdfs:comment "Device package, e.g. SOT-23." ;
    skos:altLabel "Package" .

# ---------------- Device / Wafer ----------------
ds:deviceName a owl:DatatypeProperty ;
    rdfs:domain ds:Device ; rdfs:range xsd:string ;
    skos:altLabel "Device" .

ds:hasWaferId a owl:DatatypeProperty ;
    rdfs:domain ds:Wafer ; rdfs:range xsd:string ;
    skos:altLabel "Wafer ID" .

ds:lotId a owl:DatatypeProperty ;
    rdfs:domain ds:Wafer ; rdfs:range xsd:string ;
    rdfs:comment "The lot the wafer belongs to (the Lot column of the Device Data block)." ;
    skos:altLabel "Lot" .

ds:fromWafer a owl:ObjectProperty ;
    rdfs:domain ds:Device ; rdfs:range ds:Wafer .

# ---------------- Keys (owl:hasKey) ----------------
# What identifies a thing across documents. Classes without a key (rows, results,
# measurements) always stay separate instances.
ds:Organization owl:hasKey ( ds:organizationName ) .
ds:DataSheet owl:hasKey ( ds:documentNumber ) .
ds:MeasurementRun owl:hasKey ( ds:runId ) .
ds:Device owl:hasKey ( ds:deviceName ) .
ds:Wafer owl:hasKey ( ds:hasWaferId ) .
